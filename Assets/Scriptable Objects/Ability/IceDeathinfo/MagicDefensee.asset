  m_Name: MagicDefensee
  m_EditorClassIdentifier: 
  _name: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430"
  _description: "\u043D\u0430 \u0441\u0435\u0431\u044F, \u0441\u043E\u044E\u0437\u043D\u0443\u044E
    \u0438\u043B\u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0443\u044E \u0446\u0435\u043B\u044C,
    \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \xAB\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0449\u0438\u0442\xBB
    \u043D\u0430 \"\u0425\" \u0441\u0435\u043A\u0443\u043D\u0434 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \"\u0425\" \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430 \u043D\u0430 \u0441\u0435\u0431\u0435/\u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0435
    \u0438\u043B\u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0445\u0438\u043B\u0430 \u0435\u0441\u043B\u0438 \u043D\u0430 \u0432\u0440\u0430\u0433\u0435,
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u043D\u0430 \u0446\u0435\u043B\u044C \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u043B\u043E\u0436\u0438\u0442\u044C
    \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    (\u0441\u043E\u044E\u0437\u043D\u0430\u044F \u0446\u0435\u043B\u044C) \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    (\u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0430\u044F \u0446\u0435\u043B\u044C)
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F, \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u044B\u043B\u0438 \u043D\u0430
    \u0446\u0435\u043B\u0438 \u0434\u043E \u044D\u0442\u043E\u0433\u043E \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F,
    \u043D\u043E \u043D\u0435 \u043D\u0430\u043D\u043E\u0441\u044F\u0442 \u0443\u0440\u043E\u043D
    \u0438\u043B\u0438 \u0445\u0438\u043B"
  _state: 
