  _name: "\u041F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435"
  _description: " \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u0430\u0437\u0430\u0442\u044C
    \u043D\u0430: - \xAB\u0442\u0440\u0443\u043F\xBB \u043E\u0442\u043D\u0438\u043C\u0435\u0442\u0441\u044F
    \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u043A\u043E\u043B\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0436\u0438\u0437\u043D\u0438 \u0443 \u0442\u0440\u0443\u043F\u0430 \u0432\u043F\u043B\u043E\u0442\u044C
    \u0434\u043E \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u0438 \u0438 \u043A\u043E\u043B\u043B\u0438\u0435\u0447\u0441\u0442\u0432\u043E
    \u043E\u0442\u043D\u044F\u0442\u043E\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0444\u0440\u043E\u0441\u0442 \u0434\u0435\u0437\u0443. 1 \u0440\u0443\u043D\u0430
    \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F 20 \u0435\u0434
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F + \u043F\u043E 1 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    \u043A\u0430\u0436\u0434\u0430\u044F 1 \u0435\u0434 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 40 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    - \"\u0432\u0440\u0430\u0433\u0430\" \u043D\u0430\u043D\u0435\u0441\u0451\u0442
    \u0443\u0440\u043E\u043D \u043E\u0442 \u0438\u043C\u0435\u044E\u0449\u0435\u0433\u043E\u0441\u044F
    \u0437\u0430\u043F\u0430\u0441\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u0432\u0440\u0430\u0433\u0430, \u043A\u043E\u043B\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430
    \u043D\u0430\u043B\u043E\u0436\u0438\u0442 \u043D\u0430 \u0430\u0439\u0441 \u0434\u0435\u0437\u0430
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \xAB\u0447\u0443\u0436\u0438\u0435 \u0441\u0438\u043B\u0430\xBB \u043D\u0430
    12 \u0441\u0435\u043A\u0443\u043D\u0434, \u0448\u043A\u043E\u043B\u0430 \u0442\u044C\u043C\u044B,
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0435
    \u043E\u0431\u0449\u0438\u0439 \u0437\u0430\u043F\u0430\u0441\u0430 \u0436\u0438\u0437\u043D\u0435\u0439
    \u0444\u0440\u043E\u0441\u0442 \u0434\u0435\u0437\u0443, \u043D\u0430 \u0440\u0430\u0437\u043C\u0435\u0440
    \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430,
    \u043F\u0440\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0438
    \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0441\u0442\u0432\u0438\u044F \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F.
    1 \u0440\u0443\u043D\u0430 \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442 1%
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F + \u043F\u043E 1 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    \u043A\u0430\u0436\u0434\u044B\u0439 0,1% \u0435\u0434.\u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u043E\u0442 \u0438\u043C\u0435\u044E\u0449\u0435\u0433\u043E\u0441\u044F \u0437\u0430\u043F\u0430\u0441\u0430.
    \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 40 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    - \xAB\u0441\u0435\u0431\u044F\" \u043D\u0430\u043D\u0435\u0441\u0451\u0442 \u0443\u0440\u043E\u043D
    \u0441\u0435\u0431\u0435 \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442
    \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u044D\u043D\u0435\u0440\u0433\u0438\u044E
    \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u044D\u0444\u0444\u043A\u0442
    \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438 (\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \xAB\u0440\u0435\u0441\u0443\u0440\u0441\u044B \u043D\u0438\u043D\u0434\u0437\u044F\xBB
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u0441\u043F\u0443\u0441\u0442\u044F 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
    \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u0435\u043D\u0439 \u0437\u0430\u0442\u0440\u0430\u0442\u044B)
    1 \u0440\u0443\u043D\u0430 + \u043A\u0430\u0436\u0434\u0430\u044F 1 \u0435\u0434
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    4 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 . \u0434\u043E \u043F\u043E\u043B\u043D\u043E\u0433\u043E
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
    \u043D\u0435 \u0431\u044B\u043B\u043E 40 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
    \u0437\u0430\u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044F 10 \u0445\u043F"
