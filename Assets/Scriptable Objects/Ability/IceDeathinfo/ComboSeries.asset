    - rid: 1001
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0410\u0439\u0441 \u0414\u044d\u0437 \u043c\u043e\u0436\u0435\u0442 \u0430\u0442\u0430\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0440\u0438\u044f\u043c\u0438, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u044f\u0434 \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0446\u0435\u043b\u0438 \u0432 \u043d\u0443\u0436\u043d\u043e\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0441\u043e 2\u0433\u043e \u0443\u0434\u0430\u0440\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442\u0441\u044f \u043d\u0430 +30% \u0438 \u0441\u0443\u043c\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043d\u0430 +30%, \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0430\u0442\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f 5 \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0435\u0441\u043b\u0438 \u043d\u0435\u0442\u0443 5 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0441\u0435\u0440\u0438\u044f \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u041f\u0440\u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u043c \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438 \u0441\u0435\u0440\u0438\u0438, \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0443\u0434\u0430\u0440 \u0438\u043c\u0435\u0435\u0442 \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442. \u0421\u0435\u0440\u0438\u0438: \u0424\u0424\u0424\u0424\u0424\u0424 - 6 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0434\u0430\u0440\u043e\u0432 \u0424\u0424\u0424\u0424\u0424\u041c - 5 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 1 \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443\u0434\u0430\u0440 "
