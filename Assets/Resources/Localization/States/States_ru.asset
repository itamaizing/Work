  m_TableData:
  - m_Id: 5359263744
    m_Localized: "\u0420\u0432\u0430\u043D\u0430\u044F \u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 116168581120
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 {Damage} \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 68840054784
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 {Damage} \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 1086223015936
    m_Localized: "\u041A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1380432470016
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 {PercentDamage}% \u0443\u0440\u043E\u043D\u0430 \u043E\u0442 \u043C\u0430\u043A\u0441. \u0425\u041F \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443. \u0421\u0442\u0430\u043A\u0430\u0435\u0442\u0441\u044F \u0432\u043F\u043B\u043E\u0442\u044C \u0434\u043E {MaxDuration}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 1403928961024
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 {PercentDamage}% \u0443\u0440\u043E\u043D\u0430 \u043E\u0442 \u043C\u0430\u043A\u0441. \u0425\u041F \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 23602073165824
    m_Localized: "\u041E\u0448\u0435\u043B\u043E\u043C\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 23647493283840
    m_Localized: "\u0426\u0435\u043B\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438. \u0421\u043F\u0430\u0434\u0430\u0435\u0442 \u043F\u0440\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438 \u0443\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 23679189639168
    m_Localized: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 9100200000000001
    m_Localized: "Разрушительный яд"
    m_Metadata:
      m_Items: []
  - m_Id: 9100200000000002
    m_Localized: "Наносит {DamagePerStack} за каждый стак каждые {TickInterval:seconds}. Максимум стаков: {MaxStacks}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100200000000003
    m_Localized: "Физический дебафф. Суммарный урон за тик: {Damage}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100200000000004
    m_Localized: "Восстанавливающий яд"
    m_Metadata:
      m_Items: []
  - m_Id: 9100200000000005
    m_Localized: "Восстанавливает {HealingPerStack} здоровья за каждый стак каждые {TickInterval:seconds}. Максимум стаков: {MaxStacks}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100200000000006
    m_Localized: "Физический бафф. Суммарное лечение за тик: {Healing}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100200000000007
    m_Localized: "Оглушение"
    m_Metadata:
      m_Items: []
  - m_Id: 9100200000000008
    m_Localized: "Запрещает перемещаться и использовать способности на {Duration:seconds}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100200000000009
    m_Localized: "Физический дебафф."
    m_Metadata:
      m_Items: []
  - m_Id: 9100300000000001
    m_Localized: "Осталось: {RemainingDuration:seconds}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100300000000002
    m_Localized: "Стаков: {Stacks} / {MaxStacks}."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100300000000003
    m_Localized: "Лечащий яд"
    m_Metadata:
      m_Items: []
  - m_Id: 9100300000000004
    m_Localized: "Восстанавливает {Healing} здоровья каждые {TickInterval:seconds}. Каждый следующий тик исцеляет на 1 больше."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100300000000005
    m_Localized: "Каждый эффект действует независимо."
    m_Metadata:
      m_Items: []
  - m_Id: 9100300000000006
    m_Localized: "Божественная аура"
    m_Metadata:
      m_Items: []
  - m_Id: 9100300000000007
    m_Localized: "Уменьшает перезарядку способностей на {CooldownReduction}%."
    m_Metadata:
      m_Items:
      - rid: 7005414599070581088
  - m_Id: 9100300000000008
    m_Localized: "Магический бафф."
    m_Metadata:
      m_Items: []
  - m_Id: 9100300000000009
    m_Localized: "Блокировка удара: перезарядка"
    m_Metadata:
      m_Items: []
  - m_Id: 9100300000000010
    m_Localized: "Блокировка удара против этой цели перезаряжается."
    m_Metadata:
      m_Items: []
  - m_Id: 9100300000000011
    m_Localized: ""
