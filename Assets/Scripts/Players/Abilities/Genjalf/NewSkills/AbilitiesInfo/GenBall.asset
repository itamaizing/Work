      data:
        Key: ""
        Text: "\u0441\u043e \u0441\u0432\u0435\u0440\u0445 \u0432\u044b\u0441\u043e\u043a\u043e\u0447\u0430\u0441\u0442\u043d\u044b\u043c\u00a0\u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0435\u043c \u00a0\u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u0435\u0431\u044f \u00a0\u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u044d\u043d\u0435\u0440\u0433\u0438\u044e \u0441\u0432\u0435\u0442\u0430 \u0432 \u0437\u0430\u0449\u0438\u0442\u043d\u044b\u0439 \u043a\u0443\u043f\u043e\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0433\u043b\u043e\u0449\u0430\u0435\u0442 \u0432\u0435\u0441\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c\u044b\u0439 \u0443\u0440\u043e\u043d \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 2 \u0441\u0435\u043a\u0443\u043d\u0434"
