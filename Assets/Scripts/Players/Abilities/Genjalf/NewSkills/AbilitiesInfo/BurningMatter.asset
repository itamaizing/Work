      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0435 \u0446\u0435\u043b\u0438 \u043f\u043e\u043f\u0430\u0432\u0448\u0438\u0435 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0435\u0431\u0430\u0444 \u00ab\u043e\u0431\u0436\u0438\u0433\u0430\u044e\u0449\u0430\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u044f\u00bb \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u044f\u0441\u044c \u043f\u043e\u0434 \u0434\u0435\u0431\u0430\u0444\u043e\u043c \u0446\u0435\u043b\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 3 \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u0443\u0440\u043e\u043d\u0430 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043d\u044b\u0439 \u043c\u0435\u0442\u0440 \u0441 \u043a\u0430\u0436\u0434\u044b\u043c \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043d\u044b\u043c \u043c\u0435\u0442\u0440\u043e\u043c, \u0443\u0440\u043e\u043d \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u043d\u0430 3 \u0435\u0434\u0438\u043d\u0438\u0446\u044b, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c 6 \u0441\u0435\u043a\u0443\u043d\u0434"
