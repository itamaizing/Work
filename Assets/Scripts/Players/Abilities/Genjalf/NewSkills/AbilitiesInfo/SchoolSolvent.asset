  _name: "\u0420\u0430\u0441\u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C
    \u0448\u043A\u043E\u043B"
  _descriptionTable:
    _entries:
    - rid: 1001
  _counter: 
  _icon: {fileID: 21300000, guid: ad21cf949ffd1354c9af7b1196ea1c83, type: 3}
  references:
    version: 2
    RefIds:
    - rid: 1001
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u043a\u043e\u0433\u0434\u0430 \u0433\u0430\u043d\u0433\u0434\u043e\u043b\u043b\u0430\u0440\u0444 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u043a\u043b\u0438\u043d\u0430\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0440\u0441\u043f\u044d\u043b\u043b\u043e\u043c, \u043e\u043d \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u0435\u0442 \u0448\u043a\u043e\u043b\u0443 \u0434\u043b\u044f \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u0432\u0440\u0438\u0442\u043b\u0435\u044c \u0448\u043a\u043e\u043b, \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u043a\u043e\u043f\u0438\u0442\u044c \u0432\u0441\u0435 \u0448\u043a\u043e\u043b\u044b, \u043a\u0430\u043a\u0438\u0435 \u0448\u043a\u043e\u043b\u044b \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043d\u044b , \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c \u0448\u043a\u043e\u043b \u043a \u0446\u0435\u043b\u0438 \u0441\u043e\u044e\u0437\u043d\u043e\u0439 \u0438\u043b\u0438 \u0444\u0440\u0430\u0436\u0435\u0441\u043a\u043e\u0439, \u0432\u0441\u0435 \u0431\u0430\u0444\u044b \u0438\u043b\u0438 \u0434\u0435\u0431\u0430\u0444\u044b \u044d\u0442\u043e\u0439 \u0448\u043a\u043e\u043b\u044b \u0431\u0443\u0434\u0443\u0442 \u0441\u043d\u044f\u0442\u044b \u0441 \u0446\u0435\u043b\u0438, \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438, \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043d\u044b\u0435 \u0448\u043a\u043e\u043b\u044b \u0442\u0435\u0440\u044f\u044e\u0442\u0441\u044f."
