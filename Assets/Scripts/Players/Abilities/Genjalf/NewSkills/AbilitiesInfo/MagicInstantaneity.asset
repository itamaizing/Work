  _name: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
  _description: "\u043F\u0440\u0438 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0438
    \u0443\u0440\u043E\u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u0430 \u043A\u0430\u0436\u0434\u043E\u0439
    \u043D\u043E\u0432\u043E\u0439 \u0446\u0435\u043B\u0438, \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
    \u043A\u0430\u0441\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0438 3 \u0441\u0435\u043A\u0443\u043D\u0434
    \u0431\u0443\u0434\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043D\u0430
    20%, \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0434\u043E
    100%"
