      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u043a\u043e\u0433\u0434\u0430 \u043a\u0440\u0438\u043f\u0435\u0440 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u0430\u0436\u0434\u044b\u0435 3  \u0441\u0435\u043a. \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0440\u044f\u0434 \u044f\u0434\u0430, \u0434\u043e 3 \u0441\u0442\u0430\u043a\u043e\u0432, \u0443\u0434\u0430\u0440 \u0441 \u0440\u0443\u043a\u0438 \u0442\u0440\u0430\u0442\u0438\u0442 \u0437\u0430\u0440\u044f\u0434 \u044f\u0434\u0430 \u0438 \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442 1 \u0441\u0442\u0430\u043a \"\u044f\u0434\u0430 \u043a\u043e\u0441\u0442\u0435\u0439 \",  \u043a\u043e\u0433\u0434\u0430 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0438\u0437 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438, \u0447\u0435\u0440\u0435\u0437 3 \u0441\u0435\u043a. \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u044e\u0442 \u0432\u0441\u0435 \u0437\u0430\u0440\u044f\u0434\u044b \u044f\u0434\u044b."
