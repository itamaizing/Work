      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u043a\u0440\u0438\u043f\u0435\u0440 \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043e\u0442 \u0441\u0435\u0431\u044f \u043f\u043e \u043a\u0440\u0443\u0433\u0443 \u0432\u043e\u043b\u043d\u0443 \u043f\u0430\u0440\u0430\u043b\u0435\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e \u044f\u0434\u0430, \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044f \u043d\u0430 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0435 \u0446\u0435\u043b\u0438 \"\u043f\u0430\u0440\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u044f\u0434\" \u043d\u0430 1 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e 0.5 \u0441\u0435\u043a\u0443\u043d\u0434 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u0442\u0430\u043a \u044f\u0434\u0430 \u043a\u043e\u0441\u0442\u0435\u0439. "
