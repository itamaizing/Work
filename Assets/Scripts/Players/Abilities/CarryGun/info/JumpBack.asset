      data:
        Key: ""
        Text: " \u043f\u043e\u0441\u043b\u0435 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0423\u0434\u0430\u0440\u0430 \u043a\u043e\u0433\u0442\u044f\u043c\u0438 \u043f\u043e\u0434\u0440\u044f\u0434 \u0438\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u0440\u0430 \u043a\u043e\u0433\u0442\u044f\u043c\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0441\u043b\u0435 \u0423\u0434\u0430\u0440\u0430 \u0445\u0435\u043b\u0438\u0446\u0435\u0440\u043e\u0439 \u043f\u043e\u0434\u0440\u044f\u0434 \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0446\u0435\u043b\u0438, \u041a\u044d\u0440\u0440\u0438\u0433\u0430\u043d \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1 \u0441\u0435\u043a\u0443\u043d\u0434\u044b \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043f\u0440\u044b\u0433\u043d\u0443\u0442\u044c \u043d\u0430\u0437\u0430\u0434 \u043d\u0430 1,2 \u043c\u0435\u0442\u0440\u0430."
