      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u041f\u0440\u044b\u0433\u0430\u0435\u0442 \u043a \u0432\u0440\u0430\u0433\u0443 \u0438 \u0431\u044c\u0451\u0442 \u0441 \u0445\u044d\u043b\u0438\u0446\u0435\u0440\u044b \u0441 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0443\u0440\u043e\u043d\u043e\u043c, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f: + 10% \u0435\u0441\u043b\u0438 \u043f\u0440\u044b\u0436\u043e\u043a \u0432\u043f\u043b\u043e\u0442\u043d\u0443\u044e, +20% \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043d\u044b\u0439 \u043c\u0435\u0442\u0440. \u0417\u0430\u0442\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 12 \u0441\u0435\u043a\u0443\u043d\u0434 \u043a\u0443\u043b\u0434\u0430\u0443\u043d\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439 \u044d\u0432\u043e\u043b\u044e\u0446\u0438\u0438. "
