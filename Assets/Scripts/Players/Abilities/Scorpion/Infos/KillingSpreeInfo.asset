      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: " \u043d\u0430 4 \u0441\u0435\u043a\u0443\u043d\u0434\u044b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0443\u0434\u0430\u0440\u044b \u043f\u043e \u043d\u043e\u0432\u044b\u043c \u0446\u0435\u043b\u044f\u043c \u043d\u0430\u043d\u0435\u0441\u0443\u0442 \u043d\u0430 +20% \u0443\u0440\u043e\u043d\u0430, \u0441 \u043a\u0430\u0436\u0434\u043e\u0439 \u0441\u043c\u0435\u043d\u043d\u043e\u0439 \u0446\u0435\u043b\u0438 \u0443\u0440\u043e\u043d \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 +20% (\u0442\u043e \u0435\u0441\u0442\u044c \u043f\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0446\u0435\u043b\u0438 \u0431\u0443\u0434\u0435\u0442 +40, \u043f\u043e 3\u0435\u0439 \u0446\u0435\u043b\u0438 \u0431\u0443\u0434\u0435\u0442 +60%, \u0430\u0442\u0430\u043a\u0443\u044f \u0434\u0432\u0435 \u0446\u0435\u043b\u0438 \u043f\u043e \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e - \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0441\u043c\u0435\u043d\u043e\u0439 \u0446\u0435\u043b\u0438), \u044d\u0444\u0444\u0435\u043a\u0442 \u0441\u043f\u0430\u0434\u0430\u0435\u0442 \u043f\u0440\u0438 \u0430\u0442\u0430\u043a\u0435 \u043e\u0434\u043d\u043e\u0439 \u0446\u0435\u043b\u0438 \u043f\u043e\u0434\u0440\u044f\u0434"
