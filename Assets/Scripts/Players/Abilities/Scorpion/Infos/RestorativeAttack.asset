    3% \u043E\u0442 \u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u044D\u0444\u0444\u0435\u043A\u0442
    \u0441\u043F\u0430\u0434\u0430\u0435\u0442 \u0435\u0441\u043B\u0438 3 \u0443\u0434\u0430\u0440\u0430
