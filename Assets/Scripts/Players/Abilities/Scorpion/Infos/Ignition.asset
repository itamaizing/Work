      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0441\u043a\u043e\u0440\u043f\u0438\u043e\u043d \u043f\u043e\u0434\u0436\u0438\u0433\u0430\u0435\u0442 \u0446\u0435\u043b\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 6 \u0441\u0435\u043a. \u041a\u0430\u0436\u0434\u0443\u044e \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u043d\u0430\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u0443\u0440\u043e\u043d \u043e\u0433\u043d\u0451\u043c, \u043f\u0435\u0440\u0432\u0430\u044f \u0441\u0435\u043a\u0443\u043d\u0434\u0430 1 \u0435\u0434. \u0443\u0440\u043e\u043d\u0430, +1 \u0435\u0434\u0438\u043d\u0438\u0446\u0430 \u0443\u0440\u043e\u043d\u0430, \u043a\u0430\u0436\u0434\u0430\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u0441\u0435\u043a., \u0438\u043c\u0435\u0435\u0442 5% \u0448\u0430\u043d\u043e\u043b\u0435\u0436\u043d\u0438\u044f \u043e\u043f\u0430\u043b\u0451\u043d\u043d\u043e\u0439 \u0434\u0443\u0448\u0438 \u0438 \u043a\u0430\u0436\u0434\u0443\u044e \u043f\u043e\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0448\u0430\u043d\u0441 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043e\u043f\u0430\u043b\u0451\u043d\u043d\u043e\u0439 \u0434\u0443\u0448\u0438 +5%"
