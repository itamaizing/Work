  _name: "\u041F\u043E\u0434\u0436\u0438\u0433\u0430\u043D\u0438\u0435"
  _description: "\u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u0435\u0442
