    \u0441\u0435\u043A. \u041A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443
    \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0443\u0440\u043E\u043D
    \u043E\u0433\u043D\u0451\u043C, \u043F\u0435\u0440\u0432\u0430\u044F \u0441\u0435\u043A\u0443\u043D\u0434\u0430
    1 \u0435\u0434. \u0443\u0440\u043E\u043D\u0430, +1 \u0435\u0434\u0438\u043D\u0438\u0446\u0430
    \u0443\u0440\u043E\u043D\u0430, \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
    \u0441\u0435\u043A., \u0438\u043C\u0435\u0435\u0442 5% \u0448\u0430\u043D\u043E\u043B\u0435\u0436\u043D\u0438\u044F
    \u043E\u043F\u0430\u043B\u0451\u043D\u043D\u043E\u0439 \u0434\u0443\u0448\u0438
    \u0438 \u043A\u0430\u0436\u0434\u0443\u044E \u043F\u043E\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
    \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
