      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043f\u043e\u043e\u0441\u0431\u043d\u043e\u0441\u0442\u0438 \u0438\u043c\u0435\u044e\u0442 10% \u0448\u0430\u043d\u0441 \u043a\u0440\u0438\u0442\u0430 \u04451.7\u04452.7, \u0442\u0430\u043a \u0436\u0435 \u0435\u0441\u043b\u0438 \u043d\u0430\u043a\u0430\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0434\u0435\u0431\u0430\u0444\u044b \u0441 \u00ab\u0443\u0434\u0430\u0440\u0430 \u0441 \u0440\u0443\u043a\u0438\u00bb \u0438\u043b\u0438 \u00ab\u0443\u0434\u0430\u0440\u0430 \u0441 \u043d\u043e\u0433\u0438\u00bb, \u0442\u043e \u0442\u043e\u0436\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443\u0434\u0430\u0440."
