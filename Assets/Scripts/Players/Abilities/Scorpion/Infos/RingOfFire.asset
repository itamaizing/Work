      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u043a\u043e\u0440\u043f\u0438\u043e\u043d\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u043e\u043b\u044c\u0446\u043e \u043e\u0433\u043d\u044f \u043d\u0430\u043d\u043e\u0441\u044f\u0449\u0435\u0435 \u043a\u0430\u0436\u0434\u0443\u044e \u0441\u0435\u043a\u0443\u043d\u0434\u0443 1-3 \u0435\u0434 \u0443\u0440\u043e\u043d\u0430, \u0435\u0436\u0435\u0441\u0435\u043a\u0443\u043d\u0434\u043d\u043e \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044f 1 \u0435\u0434. \u044d\u043d\u0435\u0440\u0433\u0438\u0438. \u041a\u0430\u0436\u0434\u0430\u044f \u043f\u043e\u0442\u0440\u0430\u0447\u0435\u043d\u043d\u0430\u044f \u044d\u043d\u0435\u0440\u0433\u0438\u044f \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e \u0432 2 \u0440\u0430\u0437\u0430 \u043c\u0435\u0434\u043b\u0435\u043d\u0435\u0435, \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437 \u043f\u0440\u0438 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u043d\u0430 \u0438\u043c\u0435\u0435\u0442 5% \u0448\u0430\u043d\u0441 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043e\u043f\u0430\u043b\u0451\u043d\u043d\u043e\u0439 \u0434\u0443\u0448\u0438"
