      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0435\u0441\u043b\u0438 \u0443 \u0441\u043a\u043e\u0440\u043f\u0438\u043e\u043d\u0430 \u0437\u0430\u043f\u0430\u0441 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043c\u0435\u043d\u044c\u0448\u0435 80% \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u043f\u0430\u0441\u0438\u0432\u043a\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 3 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0443\u0440\u043e\u043d\u0430 \u043d\u0430\u043d\u0435\u0441\u0443\u0442 \u043d\u0430 80% \u043c\u0435\u043d\u044c\u0448\u0435 \u0443\u0440\u043e\u043d\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0437 \u0432 10 \u0441\u0435\u043a\u0443\u043d\u0434."
