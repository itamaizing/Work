      data:
        Key: ""
        Text: "\u0412 \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0441\u0432\u0435\u0440\u0445\u0443 \u043f\u0430\u0434\u0430\u0435\u0442 \u043b\u0443\u0447 \u0441\u0432\u0435\u0442\u0430, \u043d\u0430\u043d\u043e\u0441\u044f 40 \u0435\u0434. \u0443\u0440\u043e\u043d\u0430 \u0448\u043a\u043e\u043b\u043e\u0439 \u0441\u0432\u0435\u0442\u0430 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u043c \u0446\u0435\u043b\u044f\u043c"
