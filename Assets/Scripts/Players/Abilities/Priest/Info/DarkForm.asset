      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u0446\u0430 \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u0442\u0451\u043c\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u0441\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f +15%, \u0432 \u0422\u0424 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u00ab\u0442\u0435\u043d\u044c\u00bb, \u0432\u0441\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c\u044e \u043a\u0430\u043a \u0432 \u0442\u0451\u043c\u043d\u043e\u0439 \u043f\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438, , \u043f\u0440\u0438\u043c\u0435\u043d\u044f \u043e\u0431\u0440\u0430\u0442\u043d\u0443\u044e \u043f\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043e\u0441\u0442\u044c \u043a\u0430\u043a \u0432 \u0441\u0432\u0435\u0442\u043b\u043e\u0439 \u043f\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438."
