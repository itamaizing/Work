      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0446\u044b \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 2 \u043a\u043b\u0435\u0442\u043e\u043a (4 \u0434\u0438\u0430\u043c\u0435\u0442\u0440) \u043e\u0441\u0432\u0435\u0449\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044f 20 \u0435\u0434 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0432 \u0441\u0435\u043a. \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u0446\u0435 \u0438 \u0432\u0441\u0435\u043c \u0441\u043e\u044e\u0437\u043d\u044b\u043c \u0446\u0435\u043b\u044f\u043c \u0438 \u043d\u0430\u043d\u043e\u0441\u044f\u0449\u0430\u044f 20 \u0435\u0434. \u0443\u0440\u043e\u043d\u0430 \u0432\u0441\u0435\u043c \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u043c \u0448\u043a\u043e\u043b\u043e\u0439 \u0441\u0432\u0435\u0442\u0430."
