  _name: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u0435 \u0442\u0435\u043D\u0435\u0439"
  _descriptionTable:
    _entries:
    - rid: 1001
  _counter: 
  _icon: {fileID: 21300000, guid: 3a4185520579a514291190bd487ed03e, type: 3}
  references:
    version: 2
    RefIds:
    - rid: 1001
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0412 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u043a\u043e\u043b\u043e \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0445 \u0446\u0435\u043b\u0435\u0439 \u043f\u043e\u044f\u0432\u044f\u043b\u044f\u044e\u0442\u0441\u044f \u0442\u0435\u043d\u0438 \u043d\u0430 6 \u0441\u0435\u043a\u0443\u043d\u0434, \u0438\u043c\u044e\u0449\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u0432\u0435\u0436\u0435\u043d\u0438\u044f 50% \u043e\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0446\u0435\u043b\u0438, \u043a\u0430\u0436\u0434\u0430\u044f \u0442\u0435\u043d\u044c \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f \u0438 \u0430\u0442\u0430\u043a\u0443\u0435\u0442 (\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044f \u0431\u044c\u0442\u0451 \u0440\u0443\u043a\u043e\u0439 1,2 \u0441\u0435\u043a \u043f\u0440\u0438\u043c\u0435\u043d) \u0442\u0443 \u0446\u0435\u043b\u044c \u0432\u043e\u0437\u043b\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c, \u043d\u0430\u043d\u043e\u0441\u044f 2% \u0443\u0440\u043e\u043d\u0430 \u0448\u043a\u043e\u043b\u043e\u0439 \u0442\u044c\u043c\u044b \u043e\u0442 \u043e\u0431\u0449\u0435\u0433\u043e \u0437\u0430\u043f\u0430\u0441\u0430 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0446\u0435\u043b\u0438"
