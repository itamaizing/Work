      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0435\u0441\u043b\u0438 \u0434\u0438\u0441\u043f\u0435\u043b\u0438\u0442\u0441\u044f \"\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u0435\" , \"\u043f\u043e\u0433\u043e\u0449\u0435\u043d\u0438\u0435 \u0434\u0443\u0448\u0438\" , \u0442\u043e \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0440\u044f\u0434 \u0442\u0435\u043d\u0438 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u0434\u0438\u0441\u043f\u0435\u043b\u0435\u043d\u043d\u044b\u0439 \u0441\u0442\u0430\u043a. "
