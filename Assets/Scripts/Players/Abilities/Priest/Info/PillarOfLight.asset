  m_Name: PillarOfLight
  m_EditorClassIdentifier: 
  _name: "\u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0442\u043E\u043B\u0431
    \u0441\u0432\u0435\u0442\u0430 \u0438\u0437\u043B\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u0441\u043E\u044E\u0437\u043D\u044B\u0435 \u0446\u0435\u043B\u0438 \u0438 \u043D\u0430\u043D\u043E\u0441\u044F\u0449\u0438\u0439
    \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u043C
    \u0446\u0435\u043B\u044F\u043C"
  _description: "\u043E\u0442 \u0441\u0432\u044F\u0449\u0435\u043D\u0438\u0446\u044B
    \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F \u043A\u0443\u043F\u043E\u043B
    \u043D\u0430 2 \u043C\u0435\u0442\u0440\u0430 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441,
    \u043D\u0430\u043D\u0441\u043E\u044F\u0449\u0438\u0439 \u0443\u0440\u043E\u043D
    \u0432\u0440\u0430\u0433\u0430\u043C \u043E\u0442 \u0441\u0432\u0435\u0442\u0430
    4 \u0435\u0434., \u0438 \u0438\u0437\u043B\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432 \u043D\u0430 4 \u0435\u0434"
