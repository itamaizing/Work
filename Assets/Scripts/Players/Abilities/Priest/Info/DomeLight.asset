      data:
        Key: ""
        Text: "\u043e\u0442 \u0441\u0432\u044f\u0449\u0435\u043d\u0438\u0446\u044b \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0435\u0442\u0441\u044f \u043a\u0443\u043f\u043e\u043b \u043d\u0430 2 \u043c\u0435\u0442\u0440\u0430 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441, \u043d\u0430\u043d\u0441\u043e\u044f\u0449\u0438\u0439 \u0443\u0440\u043e\u043d \u0432\u0440\u0430\u0433\u0430\u043c \u043e\u0442 \u0441\u0432\u0435\u0442\u0430 4 \u0435\u0434., \u0438 \u0438\u0437\u043b\u0435\u0447\u0438\u0432\u0430\u044e\u0449\u0438\u0439 \u0441\u043e\u044e\u0437\u043d\u0438\u043a\u043e\u0432 \u043d\u0430 4 \u0435\u0434"
