      data:
        Key: ""
        Text: " \u043e\u0442 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u0446\u044b \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0442\u0435\u043d\u044c \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 50% \u043e\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u0446\u044b \u0438 \u0438\u0434\u0435\u0442 \u043a \u0446\u0435\u043b\u0438, \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u0442\u0435\u043d\u044c \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0430 \u0446\u0435\u043b\u0438 \u043e\u043d\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0430\u0442\u0430\u043a\u043e\u0432\u0430\u0442\u044c (\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044f \u0431\u0438\u0442\u044c \u0440\u0443\u043a\u043e\u0439 1,2 \u0441\u0435\u043a\u0443\u043d\u0434 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e), \u043d\u0430\u043d\u043e\u0441\u044f 8 \u0435\u0434\u0438\u043d\u0438\u0446 \u0443\u0440\u043e\u043d\u0430 \u0442\u0451\u043c\u043d\u043e\u0439 \u043c\u0430\u0433\u0438\u0435\u0439 "
