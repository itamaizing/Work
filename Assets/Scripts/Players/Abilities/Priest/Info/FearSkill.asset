      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0441\u044f\u0449\u0435\u043d\u043d\u0438\u0446\u0430 \u0438\u0441\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0442\u0451\u043c\u043d\u0443\u044e \u044d\u043d\u0435\u0440\u0433\u0438\u044e, \u0446\u0435\u043b\u0438 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 1,5 \u043c\u0435\u0442\u0440\u0430 \u043e\u0442 \u0441\u0432\u044f\u0449\u0449\u0435\u043d\u0438\u0446\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0434\u0435\u0431\u0430\u0444\u0444 \u0442\u044c\u043c\u044b \"\u0441\u0442\u0440\u0430\u0445\", \u043d\u0430 6 \u0441\u0435\u043a\u0443\u043d\u0434, \u0446\u0435\u043b\u0438 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u0441\u044c\u044f"
