  m_Script: {fileID: 11500000, guid: 5d8548505a2c5104980a6fa13739ca3d, type: 3}
  m_Name: ShotsIntoSky
  m_EditorClassIdentifier: 
  _name: Arrows into the sky
  _description: Terafan fires a volley into the sky from several arrows at the same
    time, which deal 30 points of damage to all enemies who were in the affected
    area. The victim is also subjected to a debuff "Irradiation" lasting 9 seconds   
    The "Irradiation" debuff Reduces magical protection by 3% and increases the duration
    of negative magical effects by 1 second, increases up to 3 times.   "Rejoice
    mortals! Death itself is flying to you from heaven - Terafine"
  _icon: {fileID: 21300000, guid: 37d01a335d366b14287089f50a66b109, type: 3}
