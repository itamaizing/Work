  _icon: {fileID: 21300000, guid: 7764d8d6cfaf60840af322c247c9896b, type: 3}
  references:
    version: 2
    RefIds:
    - rid: 1001
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u041a\u0438\u0434\u0430\u0435\u0442 \u043d\u0430 \u0437\u0435\u043c\u043b\u044e \u043e\u0433\u043e\u043d\u044c, \u043f\u043e\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u043e\u0433\u043d\u044f \u043a\u0430\u0436\u0434\u0443\u044e \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \"\u0427\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435 \u043e\u0441\u043b\u0435\u043f\u043b\u0435\u043d\u0438\u0435\u201d\u043d\u0430 5 \u0441\u0435\u043a, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0441 \u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f \u0432\u0438\u0434\u043d\u044b."
    - rid: 1002
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "%%link=State[\u0427\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435 \u043e\u0441\u043b\u0435\u043f\u043b\u0435\u043d\u0438\u0435] \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0435\u0431\u0430\u0444, \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 10% \u043f\u0440\u043e\u043c\u0430\u0445\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044f\u043c, \u0441\u0443\u043c\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0434\u043e 3\u0451\u0445 \u0440\u0430\u0437, \u043a\u0430\u0436\u0434\u0443\u044e \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u0436\u0434\u043e\u0439 \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u0434\u0435\u0431\u0430\u0444\u0430  \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442\u0441\u044f \u043d\u0430 2%, \u043f\u0440\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u043c \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0432\u0440\u0435\u043c\u044f \u0434\u0435\u0431\u0430\u0444\u0430 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
