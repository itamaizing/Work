      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u041d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0435\u0431\u0430\u0444 \u043d\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u043f\u043e\u043f\u0430\u0432\u0448\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0441\u0438\u0442\u044c \u0437\u0430\u043a\u043b\u0438\u043d\u0430\u043d\u0438\u044f. \u041d\u0430 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044e \u0437\u0430\u0442\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043c\u0430\u043d\u044b 8 \u0435\u0434\u0438\u043d\u0438\u0446\u044b  \u0438 \u043f\u043e 1 \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u043d\u0430 \u043a\u0430\u0436\u0434\u0443\u044e 0,5 \u0441\u0435\u043a\u0443\u043d\u0434\u044b \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438."
