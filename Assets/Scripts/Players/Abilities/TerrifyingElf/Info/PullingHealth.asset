  m_Script: {fileID: 11500000, guid: 5d8548505a2c5104980a6fa13739ca3d, type: 3}
  m_Name: PullingHealth
  m_EditorClassIdentifier: 
  _name: Pulling health
  _description: Terafan begins to pull the life out of his enemies, reducing their
    health by 3 units per second and restoring the same amount of HP to himself.
    If there is a "silence" hanging on the target, then the execution speed is increased
    by 30%. If the "Inner Darkness" debuff is applied to the victim, then Terafine
    can use ghosts to increase the range of the ability. The ghosts will give Terafine
    25% of the taken health, and take the rest for themselves.
  _icon: {fileID: 21300000, guid: 193371c19b9788944b31bf44c9e0c270, type: 3}
