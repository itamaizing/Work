  _name: "\u0412\u0437\u0440\u0430\u0441\u0442\u0438\u0442\u044C\_ \u0434\u0435\u0440\u0435\u0432\u043E"
  _descriptionTable:
    _entries:
    - rid: 1001
  _icon: {fileID: 21300000, guid: acaa7ef11a26369409287052b9d07c29, type: 3}
  references:
    version: 2
    RefIds:
    - rid: 1001
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0412 \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0434\u0435\u0440\u0435\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0430\u0442\u0430\u043a \u0438 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438. \u0422\u044d\u0440\u0440\u0430\u0444\u0430\u0439\u043d \u043c\u043e\u0436\u0435\u0442 \u0432\u0437\u0440\u0430\u0441\u0442\u0438\u0442\u044c \u0434\u0435\u0440\u0435\u0432\u043e \u043f\u043e\u0434 \u0441\u043e\u0431\u043e\u0439, \u043d\u0430\u0445\u043e\u0434\u044f\u0441\u044c \u043d\u0430 \u0434\u0435\u0440\u0435\u0432\u0435 \u043e\u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0434\u0430\u043b\u044c\u0448\u0435 \u043e\u0442 \u0432\u0440\u0430\u0433\u043e\u0432 \u043d\u0430 1.4 \u043c\u0435\u0442\u0440\u0430, \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0435\u0451 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0430 3 \u043c\u0435\u0442\u0440\u0430 \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u0430 1.5  \u043c\u0435\u0442\u0440\u0430. \u041a\u0430\u0436\u0434\u043e\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0434\u0435\u0440\u0435\u0432\u043e, \u0432 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438 5 \u043c\u0435\u0442\u0440\u043e\u0432 \u043e\u0442 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0434\u0435\u0440\u0435\u0432\u0430, \u0432\u0437\u0440\u0430\u0449\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0434\u043e\u043b\u044c\u0448\u0435. \u0414\u0435\u0440\u0435\u0432\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0443\u0440\u043e\u043d \u043e\u0442 \u043e\u0433\u043d\u044f \u0432 2 \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435, \u043e\u0442 \u0432\u043e\u0434\u044b \u0432 2 \u0440\u0430\u0437\u0430 \u043c\u0435\u043d\u044c\u0448\u0435."
