  _name: "\u042D\u043B\u044C\u0444\u0438\u0439\u0441\u043A\u0438\u0435 \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u044B"
  _description: "\u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
    \u044D\u043B\u044C\u0444\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
    \u043C\u043E\u0436\u043D\u043E \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u044D\u043B\u044C\u0444\u0438\u0439\u0441\u043A\u0438\u0435
    \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u044B, \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0435
    \u0448\u0430\u043D\u0441 \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F
    \u043E\u0442 \u0444\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0430\u0442\u0430\u043A
    +80%, \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443
    \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044F \u043E\u0434\u0438\u043D \u0441\u0442\u0430\u043A
    \xAB\u044D\u043B\u044C\u0444\u0441\u0438\u043A\u043E\u0433\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430\""
