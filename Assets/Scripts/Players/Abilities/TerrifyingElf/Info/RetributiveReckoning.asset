  _name: "\u041A\u0430\u0440\u0430\u044E\u0449\u0430\u044F \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0430"
  _description: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0440\u0430\u0433 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0443\u0440\u043E\u043D \u0422\u0435\u0440\u0440\u0430\u0444\u0430\u0439\u043D
    \u0432 \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u0431\u043E\u044E, \u0441\u043E
    \u0441\u043F\u0438\u043D\u044B, \u0442\u043E \u0432 \u043E\u0442\u0432\u0435\u0442
    \u043D\u0430 \u044D\u0442\u043E \u044D\u043B\u044C\u0444\u0438\u0439\u043A\u0430
    \u043C\u043E\u0436\u0435\u0442 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\u0441\u044F
    \u0437\u0430 \u0441\u043F\u0438\u043D\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
    \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F
    \u043D\u0430 \u043D\u0435\u0433\u043E \u0434\u0435\u0431\u0430\u0444\u0444 \"\u0421\u0442\u0440\u0430\u0445\"
    \"\u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430
    \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u0438 \u0440\u0430\u043D\u044C\u0448\u0435
    \u0441\u043B\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0441\u0432\u043E\u0438\u043C
    \u0447\u0443\u0442\u044C\u0435\u043C, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C,
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0442\u0435\u043C\u043D\u043E\u0439
    \u043C\u0430\u0433\u0438\u0438, \u0422\u0435\u0440\u0440\u0430\u0444\u0430\u0439\u043D
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430 \u043F\u0440\u0435\u0434\u0443\u0433\u0430\u0434\u044B\u0432\u0430\u0442\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432\""
  _icon: {fileID: 21300000, guid: 1dbf779255a5a4e43a5c2914a64be01f, type: 3}
