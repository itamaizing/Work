  _name: "\u041E\u0442\u0432\u0435\u0442 \u043D\u0430 \u043F\u043E\u0434\u043B\u043E\u0441\u0442\u044C"
  _descriptionTable:
    _entries:
    - rid: 1001
  _icon: {fileID: 21300000, guid: 1dbf779255a5a4e43a5c2914a64be01f, type: 3}
  references:
    version: 2
    RefIds:
    - rid: 1001
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0421\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c, \u043f\u0440\u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u0440\u043e\u043d\u0430 \u0441\u0437\u0430\u0434\u0438 \u0441 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043d\u0435 \u0434\u0430\u043b\u044c\u0448\u0435 \u0447\u0435\u043c 0.2 \u043a\u043b\u0435\u0442\u043a\u0438,\u00a0 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1 \u0441\u0435\u043a \u0422\u044d\u0440\u0440\u0430\u0444\u0430\u0439\u043d\u00a0 \u043c\u043e\u0436\u0435\u0442 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438\u0441\u044c \u0441\u043a\u0432\u043e\u0437\u044c \u0446\u0435\u043b\u044c \u0438 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0437\u0430\u0434\u0438 \u043d\u0435\u0451, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u0422\u044d\u0440\u0440\u0430\u0444\u0430\u0439\u043d \u043d\u0435\u043b\u044c\u0437\u044f \u0431\u0438\u0442\u044c \u0438 \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0437\u0430\u043a\u043b\u0438\u043d\u0430\u043d\u0438\u044f (\u043d\u043e \u0434\u043e\u0442\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0436\u0435 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u043d\u044b \u043d\u0430\u043d\u043e\u0441\u044f\u0442 \u0443\u0440\u043e\u043d) \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u043e\u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u0441\u044f \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u0442\u0440\u0430\u0445 \u043d\u0430 \u0446\u0435\u043b\u044c\u00a0 2-3\u0441\u0435\u043a. "
