  _name: "\u041D\u0430\u0437\u0435\u043C\u043D\u0430\u044F \u043B\u043E\u0432\u0443\u0448\u043A\u0430"
  _description: "\u0422\u0435\u0440\u0440\u0430\u0444\u0430\u0439\u043D \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u043E\u044F \u043B\u043E\u0432\u0443\u0448\u043A\u0443
    \u0441 \u0437\u0430\u043F\u0430\u0441\u043E\u043C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u0432 23 \u0435\u0434\u0438\u043D\u0438\u0446\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043E\u0431\u0435\u0437\u0434\u0432\u0438\u0436\u0438\u0432\u0430\u0435\u0442
    \u043F\u043E\u043F\u0430\u0432\u0448\u0435\u0433\u043E \u0432 \u043D\u0435\u0435
    \u0432\u0440\u0430\u0433\u0430 \u0434\u043E \u0442\u0435\u0445 \u043F\u043E\u0440,
    \u043F\u043E\u043A\u0430 \u043E\u043D \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
    \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D.  \"\u0412 \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u0435
    \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u043E\u0432 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439, \u0438\u0445
    \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u0430 \u043F\u043E\u0445\u0432\u0430\u043B\u044B\"."
