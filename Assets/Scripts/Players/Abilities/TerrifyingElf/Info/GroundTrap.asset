      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0422\u044d\u0440\u0440\u0430\u0444\u0430\u0439\u043d \u0441\u0442\u0440\u0435\u043b\u044f\u0435\u0442 \u0432 \u043e\u0434\u043d\u0443 \u0442\u043e\u0447\u043a\u0443 \u043f\u043e\u0442\u043e\u043c \u0432 \u0434\u0440\u0443\u0433\u0443\u044e,( \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 \u043d\u0430\u0442\u044f\u0433\u0438\u0432\u0430\u0442\u044c \u0442\u0435\u0442\u0435\u0432\u0430 \u043b\u043e\u0432\u0443\u0448\u043a\u0438,) \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0430\u044f \u0446\u0435\u043b\u044c \u043f\u0440\u043e\u0431\u0435\u0433\u0430\u044e\u0449\u0430\u044f \u0447\u0435\u0440\u0435\u0437 \u044d\u0442\u0443 \u043b\u043e\u0432\u0443\u0448\u043a\u0443 \u043e\u0431\u0435\u0437\u0434\u0432\u0438\u0436\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f, \u043b\u043e\u0432\u0443\u0448\u043a\u0430 \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u0435\u0442.  "
