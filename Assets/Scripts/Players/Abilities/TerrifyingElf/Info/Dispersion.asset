    - rid: 1001
      type: {class: PlainText, ns: GameDescriptions, asm: Assembly-CSharp}
      data:
        Key: ""
        Text: "\u0413\u0435\u0440\u043e\u0439 \u0441\u043d\u0438\u043c\u0430\u0435\u0442 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442 \u0441 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0438\u043b\u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 - \u0441 \u0441\u043e\u044e\u0437\u043d\u0438\u043a\u0430, \u043d\u0430\u043d\u043e\u0441\u0438\u0442 30 \u0435\u0434\u0438\u043d\u0438\u0446 \u0443\u0440\u043e\u043d\u0430 \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043c. \"\u0412\u0430\u0448\u0430 \u043c\u0430\u0433\u0438\u044f - \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c \u0438\u043b\u043b\u044e\u0437\u0438\u044f. \u041f\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 \u043c\u043d\u0435 \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u043d\u0438\u0445 - \u0422\u0435\u0440\u0430\u0444\u0444\u0430\u0439\u043d\""
