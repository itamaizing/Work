      \u0441\u0435\u0431\u044F \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u0435
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0438 4 \u0441\u0435\u043A\u0443\u043D\u0434,
      \u043D\u0435 \u0443\u043C\u0438\u0440\u0430\u0435\u0442 \u0434\u0430\u0436\u0435
      \u043F\u0440\u0438 \u043D\u0443\u043B\u0435\u0432\u043E\u043C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435"
    _stateInfos: []
    IsOpen: 1
    Description: "\u0411\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u0435"
    Icon: {fileID: 21300000, guid: c9e058e06c95fa04fbfd12767e30935e, type: 3}
    Group: 0
    Row: 0
  character: {fileID: -1162350683604376873}
  _skillManager: {fileID: 9207050407313082510}
  _immortalitySkill: {fileID: 4909088627474570662}
--- !u!114 &2135330488917696545
MonoBehaviour:
  m_ObjectHideFlags: 0
