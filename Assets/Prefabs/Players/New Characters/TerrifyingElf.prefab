  _data:
    _descriptionsForInfoPanel:
    - "\u041F\u043E\u0436\u0447\u0438\u043D\u0435\u043D\u0438\u0435 \u0440\u0430\u0437\u0443\u043C\u0430
      \u2013 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C 4
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u043A\u043E\u043D\u0442\u0440\u043B\u044C
      \u043D\u0430\u0434 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u043C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
      \u0438 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0434
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C, \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E,
      \u043C\u0430\u0433\u0438\u044F, \u043C\u0430\u0433\u0438\u044F \u0442\u044C\u043C\u044B,
      40 \u043C\u0430\u043D\u044B, 40 \u0441\u0435\u043A \u043A\u0434.\_ \u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      4 \u043A\u043B\u0435\u0442\u043A\u0438 "
    - "\u041A\u043E\u0433\u0434\u0430 \u0432\u0440\u0430\u0433 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u0430
      \u0438\u043B\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432
      \u043D\u0451\u043C \u0442\u043E \u0440\u0430\u0437 \u0432 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u0438\u043C\u0435\u0435\u0442 80% \u0448\u0430\u043D\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \xAB\u0441\u0442\u0440\u0430\u0445\xBB.  \_\u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
