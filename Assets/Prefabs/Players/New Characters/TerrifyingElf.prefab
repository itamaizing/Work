--- !u!114 &6847556779729015832
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8908408265001011226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 08891c18d7818d6498a20438d4c4dba8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0438\u0438
      \u0432 \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u0430 \u0443 \u0433\u0435\u0440\u043E\u044F
      \u043C\u0435\u043D\u044C\u0448\u0435 5% \u043C\u0430\u043D\u044B - \u043F\u0440\u0438\u0437\u0440\u0430\u043A
      \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u0434\u0435\u0442."
    - "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043E\u0431\u0437\u043E\u0440\u0430 \u043D\u0430 3 \u043C\u0435\u0442\u0440\u0430,
      \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B
      \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438 \u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439
      \u043D\u0430 1.5 \u043C\u0435\u0442\u0440\u0430."
    _stateInfos: []
    IsOpen: 1
    Description: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A 1"
    Icon: {fileID: 21300000, guid: ba33a9f74e760af40acd84c6b94a4ea3, type: 3}
    Group: 0
    Row: 0
  character: {fileID: 4534754468497973439}
--- !u!114 &4689355994358733388
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8908408265001011226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2345728e2ef33b64f98a6ca5a64f8368, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u041A\u0438\u0434\u0430\u0435\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u044E
      \u043E\u0433\u043E\u043D\u044C, \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u0432 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u043E\u0433\u043D\u044F
      \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \"\u0427\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0435
      \u043E\u0441\u043B\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u201D\u043D\u0430
      5 \u0441\u0435\u043A, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0441
      \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u044C\u044E
      \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u0432\u0438\u0434\u043D\u044B."
    _stateInfos:
    - StateName: "\u0427\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0435 \u043E\u0441\u043B\u0435\u043F\u043B\u0435\u043D\u0438\u0435"
      Description: " \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0434\u0435\u0431\u0430\u0444, \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
        10% \u043F\u0440\u043E\u043C\u0430\u0445\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C,
        \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0434\u043E
        3\u0451\u0445 \u0440\u0430\u0437, \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443
        \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
        \u043A\u0430\u0436\u0434\u043E\u0439 \u0435\u0434\u0438\u043D\u0438\u0446\u044B
        \u0434\u0435\u0431\u0430\u0444\u0430  \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F
        \u043D\u0430 2%, \u043F\u0440\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C
        \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0438 \u0432\u0440\u0435\u043C\u044F
        \u0434\u0435\u0431\u0430\u0444\u0430 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
        \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F.\_"
    IsOpen: 1
    Description: "\u0420\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043E\u0433\u043E\u043D\u044C"
    Icon: {fileID: 21300000, guid: 3daccdca469e8c7408109fb56b87cf0b, type: 3}
    Group: 0
    Row: 0
  character: {fileID: 4534754468497973439}
  reconnaissanceFire: {fileID: 2750012758126725032}
  terrifyingElfAura: {fileID: 6686568037796463366}
  ability: {fileID: 4092227064955680494}
--- !u!114 &3199921141022633158
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8908408265001011226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c70ee20a4412f7241950439beb32b4a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D
      \u0438\u043C\u0435\u0435\u0442 10% \u0448\u0430\u043D\u0441 \u043D\u0430\u043B\u043E\u0436\u0438\u0442\u044C
      \"\u042D\u043B\u044C\u0444\u0438\u0439\u0441\u043A\u043E\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E\"
      \u043D\u0430 3 \u0441\u0435\u043A"
    _stateInfos:
    - StateName: "\u042D\u043B\u044C\u0444\u0438\u0439\u0441\u043A\u043E\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E"
      Description: "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
        \u043D\u0430 \u0445\u043E\u0434\u0443, \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
        \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043D\u0430
        10%, \u0441\u0442\u0430\u043A 3 \u0440\u0430\u0437\u0430. \u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0431\u0430\u0444\u0444."
    IsOpen: 1
    Description: "\u042D\u043B\u044C\u0444\u0438\u0439\u0441\u043A\u043E\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E "
    Icon: {fileID: 21300000, guid: 523655bbfbe8b0b42869f25f34886283, type: 3}
    Group: 0
    Row: 0
  character: {fileID: 4534754468497973439}
  terrifyingElfAura: {fileID: 6686568037796463366}
--- !u!114 &8301483179927327488
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8908408265001011226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7efe41853d33c44cbce1f73cb760d1b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0432 \u043D\u0435\u0431\u043E
      \u0441\u0442\u0440\u0435\u043B\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0447\u0435\u0440\u0435\u0437 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E
      \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0443\u0440\u043E\u043D, \u0438\u043C\u0435\u0435\u0442 30% \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
      \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430
      \u04451.6-2,4, \u0442\u0430\u043A \u0436\u0435 \u0431\u0430\u0437\u043E\u0432\u044B\u0439
      \u0443\u0440\u043E\u043D \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043E\u0442
      \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0442\u0440 \u043F\u043B\u044E\u0441
      +5%"
    _stateInfos: []
    IsOpen: 0
    Description: "\u0421\u0442\u0440\u0435\u043B\u0430 \u0432 \u043D\u0435\u0431\u043E"
