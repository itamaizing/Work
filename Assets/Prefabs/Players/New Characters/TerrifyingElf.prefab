  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0412\u0437\u0440\u0430\u0449\u0438\u0432\u0430\u0435\u0442 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0435.
      \u0414\u0435\u0440\u0435\u0432\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0435\u043C. \u041F\u0440\u0438
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
      \u043F\u043E\u0434 \u0441\u0435\u0431\u044F - \u0433\u0435\u0440\u043E\u0439
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043E,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043E\u0431\u0437\u043E\u0440\u0430 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439.
      \u041A\u0430\u0436\u0434\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432 2 \u0440\u0430\u0437\u0430."
