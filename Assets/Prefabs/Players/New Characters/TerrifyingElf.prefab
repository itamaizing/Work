  _data:
    _descriptionsForInfoPanel:
    - "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0432 \xAB\u0410\u0441\u0442\u0440\u0430\u043B\xBB
      \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E \u0446\u0435\u043B\u044C"
    _stateInfos:
    - StateName: "\u0410\u0441\u0442\u0440\u0430\u043B"
      Description: "\u043F\u0440\u0438 \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438
        \u0432 \xAB\u0410\u0441\u0442\u0440\u0430\u043B\u0435\xBB \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
        \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u043D\u0430 50%,
        \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439 \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u043C\u044B\u0439
        \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D
        \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043D\u0430 50%, \u043D\u0435\u043B\u044C\u0437\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
        \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0443\u0440\u043E\u043D, \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
        \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
        \u0432 \u043F\u043E\u043B\u043D\u043E\u043C \u043E\u0431\u044A\u0451\u043C\u0435
        \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C
        \u0443\u0440\u043E\u043D, \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u043D\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439
        4 \u0441\u0435\u043A\u0443\u043D\u0434\u044B, \u0441\u0443\u0449\u0435\u0441\u0442\u0432
        30 \u0441\u0435\u043A\u0443\u043D\u0434, \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u044D\u0444\u0444\u0435\u043A\u0442."
    IsOpen: 0
