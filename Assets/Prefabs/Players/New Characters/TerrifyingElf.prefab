  _data:
    _descriptionsForInfoPanel:
    - "\u041F\u0440\u0438\u0437\u0440\u0430\u043A -\_ \u043D\u0430\_\u043A\u0430\u0440\u0442\u0435
      \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\_\u041F\u0440\u0438\u0437\u0440\u0430\u043A\u0430,
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
