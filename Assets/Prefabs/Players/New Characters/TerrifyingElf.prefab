      \u0422\u044D\u0440\u0440\u0430\u0444\u0430\u0439\u043D, \u043F\u043E\u0441\u043B\u0435
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u041F\u0440\u0438\u0437\u0440\u0430\u043A
      \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0435\u0442, \u041F\u0440\u0438\u0437\u0440\u0430\u043A
      \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0443\u0440\u043E\u043D, \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
      \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C 2 \u041F\u0440\u0438\u0437\u0440\u0430\u043A\u0430, 
      \u0432\u0440\u0435\u043C\u044F \u043A\u0430\u0441\u0442\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
