  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u043F\u0435\u0440\u0435\u0434 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u043C
      \u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u0443
      \u0442\u0451\u043C\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      6 \u0435\u0434. \u0443\u0440\u043E\u043D\u0430, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430
      \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u043D\u0430 30%. \u041D\u0430
      \u0436\u0435\u0440\u0442\u0432\u0443 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439\_\u044D\u0444\u0444\u0435\u043A\u0442
      \xAB\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u0442\u044C\u043C\u0430\xBB\_
      \u043D\u0430 13 \u0441\u0435\u043A\u0443\u043D\u0434, \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0434\u043E 6 \u0440\u0430\u0437, \u0441 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043D\u043E\u0432\u044B\u043C \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
      \u043E\u0431\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u044D\u0444\u0444\u0435\u043A\u0442\u0430 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 2 \u0441\u0435\u043A, \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      6 \u0435\u0434\u0438\u043D\u0438\u0446 \xAB\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F
      \u0422\u044C\u043C\u0430\xBB. \u041D\u0430 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044E
      \u0437\u0430\u0442\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F 
      \u043C\u0430\u043D\u044B 4 \u0435\u0434\u0438\u043D\u0438\u0446\u044B  \u0438
      \u043F\u043E 1 \u0435\u0434\u0438\u043D\u0438\u0446\u044B \u043D\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      1 \u0435\u0434\u0438\u043D\u0438\u0446\u0443 \u0443\u0440\u043E\u043D\u0430. "
    _stateInfos:
    - StateName: "\_\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F
        \u0442\u044C\u043C\u0430"
      Description: "\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u044D\u0444\u0444\u0435\u043A\u0442 \u0442\u044C\u043C\u044B \u043F\u0440\u0438
        \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0438 6 \u0435\u0434\u0438\u043D\u0438\u0446
        \u043D\u0430 \u0436\u0435\u0440\u0442\u0432\u0435 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
        0.7-1.4 \u0441\u0435\u043A \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
