  _data:
    _descriptionsForInfoPanel:
    - "\u043A\u0440\u0438\u043F\u0435\u0440 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442
      \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0437\u043C, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043A\u0430\u0441\u0442\u043E\u0432, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F
      \u043A\u0443\u043B\u0434\u0430\u0443\u043D\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 2 \u0440\u0430\u0437\u0430, 80 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0443\u0434\u0430\u0440 \u0440\u0443\u043A\u043E\u0439
      \u0438\u043C\u0435\u0435\u0442 30% \u0448\u0430\u043D\u0441 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u0446\u0435\u043B\u0438 \xAB\u0438\u0441\u0441\u0443\u0448\u0430\u044E\u0449\u0438\u043C
      \u044F\u0434\u043E\u043C\xBB"
