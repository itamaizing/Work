  _data:
    _descriptionsForInfoPanel:
    - "\u043F\u0440\u0438 \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0438
      \u043B\u044E\u0431\u043E\u0433\u043E  \u044F\u0434\u0430 \u043D\u0430 \u0446\u0435\u043B\u044C,
      \u043A\u0440\u0438\u043F\u0435\u0440 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0430\u0444
      \"\u0447\u0443\u0432\u0441\u0442\u0432\u043E \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439\"
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043D\u0430 10% \u043D\u0430 2
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B, \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0434\u043E 6 \u0440\u0430\u0437,  \u043F\u0440\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C
      \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0438 \u0432\u0440\u0435\u043C\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F  "
