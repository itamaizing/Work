--- !u!114 &6456863432087837353
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7437800528419325459}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6585044261016c24bbe7ec3b22102a75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\xAB\u041D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u044C\xBB
      \u2013 \u0435\u0441\u043B\u0438 \u0440\u044F\u0434\u043E\u043C \u043D\u0435
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438 \u0431\u043B\u0438\u0436\u0435
      6 \u043A\u043B\u0435\u0442\u043E\u043A \u0438 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0443\u0440\u043E\u043D \u0431\u043E\u043B\u0435\u0435 6 \u0441\u0435\u043A\u0443\u043D\u0434.,
      \u043A\u0440\u0438\u043F\u0435\u0440 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C
      \xAB\u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u044C\xBB:
      \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u044F\u0442 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435
      \u0446\u0435\u043B\u0438, -30% \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434\u0432\u0435\u0436\u0435\u043D\u0438\u044F, +30%
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u0438
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438,  \u043C\u043E\u0436\u043D\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u044F \u0438\u0437 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u0438, 
      \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u044C \u0441\u043F\u0430\u0434\u0430\u0435\u0442
      \u0435\u0441\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0443\u0440\u043E\u043D.
      \u041A\u043E\u0433\u0434\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0432 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u0438
      \u0437\u0430\u0442\u0440\u0430\u0442\u044B \u044D\u043D\u0435\u0440\u0433\u0438\u0438
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 30% "
