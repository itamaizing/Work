    - '-'
    _stateInfos:
    - StateName: "\u041E\u0441\u043B\u0435\u043F\u043B\u0435\u043D\u0438\u0435"
      Description: " \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043D\u0430 5 \u0441\u0435\u043A,
        \u0446\u0435\u043B\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0446\u0435\u043B\u0435\u0432\u044B\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438,
        \u0437\u0430\u0442\u0435\u043C\u043D\u044F\u0435\u0442\u0441\u044F \u044D\u043A\u0440\u0430\u043D,
        \u0435\u0441\u043B\u0438 \u0446\u0435\u043B\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441
        \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u0443\u044E
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0438
        \u0432 \u044D\u043A\u0440\u0430\u043D\u0435 \u0449\u0435\u043B\u0447\u043A\u043E\u043C
        \u043C\u044B\u0448\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442
        \u0432 \u0446\u0435\u043B\u044C, \u0442\u043E \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u044D\u0444\u0444\u0435\u043A\u0442 \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u0441\u0442
        \u0446\u0435\u043B\u0438\u0442\u0441\u044F \u0432 \u0446\u0435\u043B\u044C,
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0431\u0443\u0434\u0435\u0442
