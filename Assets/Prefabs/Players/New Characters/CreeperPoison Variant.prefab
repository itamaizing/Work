  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReptileTalent_5
  _data:
    _descriptionsForInfoPanel:
    - "\"\u0441\u0432\u043E\u044F \u0441\u0442\u0438\u0445\u0438\u044F\" - \u043A\u0430\u0436\u0434\u044B\u0439
      \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u044F\u0434 \u043D\u0430
      \u0446\u0435\u043B\u044F\u0445 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
      6 \u043C\u0435\u0442\u0440\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439  \u043D\u0430
      10%, \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u0430\u043A \u044F\u0434\u0430
      \u0442\u043E\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F"
