--- !u!114 &1734068584079679132
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7437800528419325459}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d337041733aeb0a42b68ca5a03b1854c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0434\u0435\u0431\u0430\u0444 \xAB\u044F\u0434 \u043A\u043E\u0441\u0442\u0435\u0439\xBB
      \u0434\u0430\u0451\u0442 5% \u0448\u0430\u043D\u0441 \u043D\u0430\u043D\u0435\u0441\u0442\u0438
      \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0434\u0430\u0440 
      \u04452,5 \u043E\u0442 \u0443\u0434\u0430\u0440\u0430 \u0441 \u0440\u0443\u043A\u0438,
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0441\u0442\u0430\u043A \xAB\u044F\u0434 \u043A\u043E\u0441\u0442\u0435\u0439\xBB
      \u0434\u0430\u0451\u0442  +1 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0443\u0434\u0430\u0440\u0430,  \u0442\u043E \u0435\u0441\u0442\u044C 3 \u0441\u0442\u0430\u043A\u0430
      \u0434\u0430\u044E\u0442 10% \u0448\u0430\u043D\u0441 \u04452.5 +1 +1 = \u04455,5 
      \u043A\u0440\u0438\u0442 \u0443\u0434\u0430\u0440."
    - "\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u043A\u0430 \u043D\u0430
      \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u0430\u0445 - \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      1 \u0441\u0435\u043A \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442\u0441\u044F
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F
      \u043E\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0443\u0434\u0430\u0440\u0430
      \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F  +60% \u0434\u0430\u043B\u044C\u043D\u0435\u0433\u043E
      \u0431\u043E\u044F +100%."
    _stateInfos: []
    Description: "\u0424\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u043A\u0430
      \u043D\u0430 \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u0430\u0445 "
