  _data:
    _descriptionsForInfoPanel:
    - "\"\u041F\u043B\u0435\u0432\u043E\u043A \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u0439\"
      \u0438 \"\u043F\u043E\u0434\u043B\u044B\u0439 \u041F\u043B\u0435\u0432\u043E\u043A\"
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442  \u043D\u0430
