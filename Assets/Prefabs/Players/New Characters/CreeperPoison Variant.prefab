--- !u!114 &964801864059339207
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7437800528419325459}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 892a2cdbc2c640540b3c56270eee079d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PoisonTalent_3
  _data:
    _descriptionsForInfoPanel:
    - "\u043A\u0440\u0438\u043F\u0435\u0440 \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u0435\u0442
      \u0448\u0430\u0440 \u044F\u0434\u0430 \u0432 \u0440\u0443\u043A\u0435 \u0438
      \u0431\u044C\u0435\u0442 \u0438\u043C \u0441 \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044F \u0446\u0435\u043B\u044C.
      \u041F\u043E\u0441\u043B\u0435 \u0434\u0432\u0443\u0445 \u043F\u043E\u0434\u0440\u044F\u0434
      \xAB\u0443\u0434\u0430\u0440 \u0441 \u0440\u0443\u043A\u0438\xBB \u2013 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F +50%, \u043F\u043E\u0441\u043B\u0435
      \xAB\u043C\u043E\u043B\u043D\u0438\u0435\u043D\u043E\u0441\u043D\u044B\u0435
      \u0443\u0434\u0430\u0440\u044B\xBB \u2013 100%. \u0423\u0440\u043E\u043D 30
      \u0435\u0434, \u0440\u0435\u0441\u0443\u0440\u0441\u044B: 30 \u0435\u0434 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
      \u0438 \u0437\u0430\u0440\u044F\u0434 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \xAB\u0428\u0430\u0440 \u044F\u0434\u0430\xBB. \u041E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u0446\u0435\u043B\u044C \u043D\u0430 3 \u043A\u043B\u0435\u0442\u043A\u0438,
      \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      1.6 \u0441\u0435\u043A\u0443\u043D\u0434, \u0432\u0440\u0435\u043C\u044F \u043A\u0430\u0441\u0442\u0430
      0.4, \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C. "
    _stateInfos: []
    Description: "\u042F\u0434\u043E\u0432\u0438\u0442\u044B\u0439 \u0448\u043B\u0435\u043F\u043E\u043A"
