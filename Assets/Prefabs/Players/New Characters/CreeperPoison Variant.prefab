--- !u!114 &5042264585882244307
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7437800528419325459}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 301d527d38284084ba4a8aa9d730a3c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReptileTalent_2
  _data:
    _descriptionsForInfoPanel:
    - "\xAB\u043C\u043E\u043B\u043D\u0438\u0435\u043D\u043E\u0441\u043D\u043E\u0435
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\xBB
      - \u041A\u0440\u0438\u043F\u0435 \u0431\u0435\u0436\u0438\u0442 \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0441\u043A\u0432\u043E\u0437\u044C
      \u0446\u0435\u043B\u0438, \u043D\u0430\u043D\u043E\u0441\u044F  \u0443\u0434\u0430\u0440
      \u0441 \u0440\u0443\u043A\u0438 \u043A\u0430\u0436\u0434\u043E\u0439 \u0446\u0435\u043B\u0438,
      \u0435\u0441\u043B\u0438 \u043D\u0430 \u043F\u0443\u0442\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438\u0441\u044C
      \u0446\u0435\u043B\u0438, \u0442\u043E \u043A\u0440\u0438\u043F\u0435\u0440
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0432\u0435\u043A\u0442\u043E\u0440 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
      \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438
      \u043A\u0440\u0438\u043F\u0435\u0440 \u0442\u0430\u043A \u0436\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0443\u0434\u0430\u0440\u044B \u0441 \u0440\u0443\u043A\u0438. "
    _stateInfos: []
    Description: "\u041C\u043E\u043B\u043D\u0438\u0435\u043D\u043E\u0441\u043D\u043E\u0435
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    ConditionDescription: 
    Icon: {fileID: -2889036831652375965, guid: 0ecb6aa3d380cce48bb2d427267b10be, type: 3}
