  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d00e092a67623bd49976cae56be95235, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NinjaPoisonTalent_4
  _data:
    _descriptionsForInfoPanel:
    - " \"\u0441\u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440 (\u0440\u0430\u043D\u0435\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0441\u044F
      \u0441\u0442\u044B\u043B\u0430\u044F \u043A\u0440\u043E\u0432\u044C)\"  \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0443\u0434\u0430\u0440 \u0441 \u0440\u0443\u043A\u0438 \u0431\u0443\u0434\u0435\u0442
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0441 \u043A\u0440\u0438\u0442\u0430
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C \u04452.5 \u043E\u0442 \u0443\u0440\u043E\u043D\u0430
      \u0438\u043B\u0438 \u0435\u0441\u043B\u0438 \u043A\u0440\u0438\u0442 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
      \u0441 \u0442\u0430\u043B\u0430\u043D\u0442\u043E\u0432 \u0434\u0430\u044E\u0449\u0438\u043C
      5% \u0448\u0430\u043D\u0441 \u043A\u0440\u0438\u0442\u0430 \u043E\u0442 \"\u044F\u0434\u0430
      \u043A\u043E\u0441\u0442\u0435\u0439\"),  \u0442\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043A\u0440\u0438\u0442\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435 . \u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0431\u0435\u0437 \u0433\u043A\u0434,
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C, 
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u0435\u0442
      \u0443\u0434\u0430\u0440 \u0440\u0443\u043A\u043E\u0439, \u043A\u0434 8 \u0441\u0435\u043A
      \u043E\u0442 \u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
      \u043A\u0430\u043A \u0443\u0434\u0430\u0440 \u0440\u0443\u043A\u043E\u0439
      \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0451\u0442,  \u0435\u0441\u043B\u0438
      \u0431\u044C\u0451\u0442 \u0438\u0437 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0438,
      \u043D\u0430\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u044C \u0441\u043F\u0430\u0434\u0430\u0435\u0442. "
    _stateInfos: []
    Description: "\u0441\u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440"
