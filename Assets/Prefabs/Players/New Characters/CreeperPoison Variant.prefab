  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReptileTalent_7
  _data:
    _descriptionsForInfoPanel:
    - "\u043A\u0430\u0436\u0434\u044B\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
