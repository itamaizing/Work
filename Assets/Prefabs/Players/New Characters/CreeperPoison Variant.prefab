  _data:
    _descriptionsForInfoPanel:
    - " \u041B\u0435\u0447\u044F\u0449\u0438\u0439 \u0448\u0430\u0440 - \"\u0448\u0430\u0440
      \u044F\u0434\u0430\" \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0441\u0435\u0431\u044F \u0438\u043B\u0438 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044F \u0441\u0435\u0431\u044F \u0438\u043B\u0438
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430 \u0446\u0435\u043B\u044C\_ 
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439 \u0448\u0430\u0440 \u044F\u0434\u0430
      \u043B\u0435\u0447\u044F\u0449\u0438\u0439 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0431\u0430\u0444 \u043D\u0430 6 \u0441\u0435\u043A \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0431\u0430\u0444 \"\u043B\u0435\u0447\u044F\u0449\u0438\u0439 \u044F\u0434\"
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u0435\u0438\u0439 \u044D\u0444\u0444\u0435\u043A\u0442,,
      \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0435\u043A\u0443\u043D\u0434\u043E\u0439
      \u044D\u0444\u0444\u0435\u043A\u0442 \u0438\u0441\u0446\u0435\u043B\u0435\u043D\u0438\u044F
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0430 1 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0441\u0442\u0430\u043A \u0448\u0430\u0440\u0430 \u044F\u0434\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      \u043B\u0435\u0447\u0438\u0442, \u043F\u0440\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C
      \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0438 \u0432\u0440\u0435\u043C\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043D\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F 
      \u0443 \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u0448\u0430\u0440\u0430
      \u044F\u0434\u0430 \u044D\u0444\u0444\u0435\u043A\u0442 \u043B\u0435\u0447\u0438\u0442
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E 14 \u0445.\u043F. "
