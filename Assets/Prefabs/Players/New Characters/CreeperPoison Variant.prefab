--- !u!114 &8303087721396363938
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7437800528419325459}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b2f4a8fbf25c53469ae6daddff74806, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReptileTalent_3
  _data:
    _descriptionsForInfoPanel:
    - "\u043A\u0440\u0438\u043F\u0435\u0440 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442\u0441\u044F,
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0435\u0433\u043E \u0431\u0435\u0433\u0430,
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430  80 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
      , 14 \u0441\u0435\u043A. \u041A\u0434, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0431\u0435\u0433\u0430, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439, \u0448\u0430\u043D\u0441
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435  \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 2 \u0440\u0430\u0437\u0430, \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      3 \u0441\u0435\u043A., \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u0430\u044F, 
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C"
    _stateInfos: []
    Description: " \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0440\u0435\u043F\u0442\u0438\u043B\u0438\u0438"
    ConditionDescription: 
    Icon: {fileID: 7595241771238511587, guid: eb1e53bce0abfd940816bf6d5da4ce56, type: 3}
