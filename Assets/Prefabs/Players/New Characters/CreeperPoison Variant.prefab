  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PoisonTalent_13
  _data:
    _descriptionsForInfoPanel:
    - "\u0412\u043E\u043B\u043D\u0430 \u043F\u0430\u0440\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
      \u044F\u0434\u0430 - \u043A\u0440\u0438\u043F\u0435\u0440 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043E\u0442 \u0441\u0435\u0431\u044F \u043F\u043E \u043A\u0440\u0443\u0433\u0443
      \u0432\u043E\u043B\u043D\u0443 \u043F\u0430\u0440\u0430\u043B\u0435\u0437\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
      \u044F\u0434\u0430, \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F
      \u043D\u0430 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0446\u0435\u043B\u0438
      \"\u043F\u0430\u0440\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0439
      \u044F\u0434\" \u043D\u0430 1 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0438
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E 0.5 \u0441\u0435\u043A\u0443\u043D\u0434 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 
      \u0441\u0442\u0430\u043A \u044F\u0434\u0430 \u043A\u043E\u0441\u0442\u0435\u0439. "
    _stateInfos:
    - StateName: "\u043F\u0430\u0440\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0439
        \u044F\u0434"
      Description: "\u0444\u0438\u0437 \u0434\u0435\u0431\u0430\u0444\u0444 \u0446\u0435\u043B\u044C
        \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
        \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438.\n\u0441\u0438\u0441
        \u0438\u043D\u0444\u043E: \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F,
        \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C 3 \u043C\u0435\u0442\u0440\u0430
        \u0440\u0430\u0434\u0438\u0443\u0441 ( 6\u043C\u0435\u0442\u0440\u043E\u0432
        \u0434\u0438\u0430\u043C\u0435\u0442\u0440) \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F
        1,5 \u0441\u0435\u043A\u0443\u043D\u0434, \u0447\u0435\u0440\u0435\u0437
        1,5 \u0441\u0435\u043A\u0443\u043D\u0434 \u0432\u044B\u043B\u0435\u0442\u0430\u0435\u0442
        \u0432\u043E\u043B\u043D\u0430, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        1 \u043C\u0435\u0442\u0440 \u0432 0.2 \u0441\u0435\u043A, \u0431\u0435\u0441\u0446\u0435\u043B\u0435\u0432\u0430\u044F
        \u0441 \u043A\u043B\u0438\u043A\u043E\u043C\n"
    Description: "\u0412\u043E\u043B\u043D\u0430 \u043F\u0430\u0440\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
      \u044F\u0434\u0430"
