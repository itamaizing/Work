  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u043D\u0438\u043D\u0434\u0437\u044F \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439
      \u043F\u043E\u0441\u044B\u043B\u0430\u0435\u0442 \u043B\u0435\u0434\u0435\u043D\u044F\u0449\u0438\u0439
      \u043F\u043E\u0442\u043E\u043A, \u0432\u0441\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435
      \u0446\u0435\u043B\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435
      \u0432 \u043F\u043E\u0442\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      \u0443\u0440\u043E\u043D \u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0434\u0435\u0431\u0430\u0444\u044B \u0412 \u043F\u0435\u0440\u0432\u044B\u0435
      0,3 \u0441\u0435\u043A. \u043D\u0430\u043D\u043E\u0441\u0438\u0442 1 \u0435\u0434
      \u0443\u0440\u043E\u043D\u0430 \u0448\u043A\u043E\u043B\u0430 \u0432\u043E\u0434\u044B,
      \u043A\u0430\u0436\u0434\u044B\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      0,3 \u0441\u0435\u043A + 1 \u0435\u0434. \u0443\u0440\u043E\u043D\u0430 (0,3-1
      0,6-2, 0,9-3, 1,2-4, 1,5-5, 1,8-6, 2,1-7), \u043A\u0430\u0436\u0434\u044B\u0435
      0,3 \u0441\u0435\u043A \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u0435\u0431\u0430\u0444 \xAB\u041E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435\xBB
      \u043D\u0430 12 \u0441\u0435\u043A "
    _stateInfos:
    - StateName: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430"
      Description: "\u0446\u0435\u043B\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
        \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
        \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043B\u044E\u0431\u044B\u0435
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435
        \u0443\u0440\u043E\u043D\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
        \u0434\u043B\u0435\u0431\u0430\u0444, \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0434\u0435\u0431\u0430\u0444, \u0448\u043A\u043E\u043B\u0430 \u0432\u043E\u0434\u044B."
    IsOpen: 0
    Description: "\u043E\u0445\u043B\u0430\u0436\u0434\u0430\u044E\u0449\u0438\u0439 
      \u043F\u043E\u0442\u043E\u043A"
