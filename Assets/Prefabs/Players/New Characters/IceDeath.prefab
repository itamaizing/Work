    - "\u041B\u0435\u0434\u044F\u043D\u043E\u0439  \u043F\u043E\u0434\u043A\u0430\u0442
      \u2013 \u0443\u0435\u0437\u0436\u0430\u0435\u0442 \u0432 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043D\u0430 2 \u043C\u0435\u0442\u0440\u0430
      + 1 \u043C\u0435\u0442\u0440 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435
      5 \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
      10 \u044D\u043D\u0435\u0440\u0433\u0438\u0438.  \u0412 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0438
      \u0441\u0435\u0440\u0438\u0438: \u0443\u0435\u0437\u0436\u0430\u0435\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0446\u0435\u043B\u044C\u044E
      \u0438\u043B\u0438 \u0443\u0435\u0437\u0436\u0430\u0435\u0442 \u0431\u0435\u0437
      \u0446\u0435\u043B\u0438 \u043D\u0430 50% \u0434\u0430\u043B\u044C\u0448\u0435."
