--- !u!114 &6142297959774152765
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8789458529339427208}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 831a6883cec0e3a4f810f52ae1ae547f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u041B\u0443\u0436\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u044F
      \u2013 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442
      \u043B\u0443\u0436\u0443 \u043D\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434
      + 1 \u0441\u0435\u043A\u0443\u043D\u0434\u0430 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435
      5 \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
      20 \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438
      \u0432\u0440\u0430\u0433\u0430 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u0435\u0431\u0430\u0432 \u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u0435
      \u043D\u0430 \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0435\u0441\u044F \u0432\u0440\u0435\u043C\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043B\u0443\u0436\u044B.
      \u041F\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u044F \u2013 \u0446\u0435\u043B\u044C "
    - "\u0417\u0430\u043C\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u044E\u0449\u0430\u044F
      \u0442\u0435\u043D\u044C \u2013 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0442\u0435\u043D\u044C \u043D\u0430 2 \u0441\u0435\u043A \u0438 + 1 \u0441\u0435\u043A.
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 10 \u0435\u0434. \u044D\u043D\u0435\u0440\u0433\u0438\u0438
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 30 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
      \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u0432\u0440\u0430\u0433\u0430
      \u0432 \u0442\u0435\u043D\u044C \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u0435\u0431\u0430\u0444 \u201C\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430\u201D. "
    _stateInfos:
    - StateName: "\u041F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u044F"
      Description: "\u0446\u0435\u043B\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
        \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F,
        \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        \u0444\u0438\u0437\u0438\u0447\u0435\u043A\u0438\u0445 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439
        \u043D\u0430 50% \u043F\u0440\u0438 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0438
        \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C 30 \u0435\u0434\u0438\u043D\u0438\u0446
        \u0444\u0438\u0437\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430
        \u0432 \u0441\u0443\u043C\u043C\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u0435
        \u0441\u043F\u0430\u0434\u0430\u0435\u0442, \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0434\u0435\u0431\u0430\u0444."
    - StateName: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430"
      Description: "\u0446\u0435\u043B\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
        \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
        \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043B\u044E\u0431\u044B\u0435
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435
        \u0443\u0440\u043E\u043D\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
        \u0434\u043B\u0435\u0431\u0430\u0444, \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0434\u0435\u0431\u0430\u0444, \u0448\u043A\u043E\u043B\u0430 \u0432\u043E\u0434\u044B."
    IsOpen: 0
    Description: "\u041B\u0443\u0436\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u044F"
