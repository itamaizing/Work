    - "\u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u043D\u0438\u043D\u0434\u0437\u044E \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0431\u0430\u0444, \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F:
      \xAB\u0443\u0434\u0430\u0440 \u0441 \u0440\u0443\u043A\u0438\" \u0438 \"\u043E\u0441\u043A\u043E\u043B\u043E\u043A
      \u043B\u044C\u0434\u0430\" \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      60% \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0438 \u043D\u0430\u043B\u043E\u0436\u0438\u0442\u044C
      \u0434\u0435\u0431\u0430\u0444 \u201E\u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435\u201C. 
      \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0443\u0440\u043E\u043D \u0448\u043A\u043E\u043B\u043E\u0439 \u0432\u043E\u0434\u044B
      \u0441\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439
      (\u0437\u0430\u043C\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u044E\u0449\u0435\u0435
      \u043E\u0431\u043B\u0430\u043A\u043E, \u043B\u0435\u0434\u044F\u043D\u0430\u044F
      \u0442\u0435\u043D\u044C, \u043E\u0445\u043B\u0430\u0436\u0434\u0430\u044E\u0449\u0438\u0439
      \u043F\u043E\u0442\u043E\u043A, \u043B\u0443\u0436\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u044F, 
      \u043A\u0440\u0443\u0433 \u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u044F)
      \u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \"\u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435\" \"\u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u0435\"
      \"\u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430\", \u0442\u043E \u043D\u0430\u043D\u043E\u0441\u0438\u043C\u044B\u0439
      \u0443\u0440\u043E\u043D \u0443\u0432\u0435\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F: 
      - \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435 +1 \u0435\u0434
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0435\u043C\u044B\u0439
      \u0441\u0442\u0430\u043A (\u043D\u0435 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0441\u0442\u0430\u043A \u043F\u043E 1 \u0435\u0434, \u0430 \u0437\u0430 \u0432\u0441\u0435
      \u0441\u0442\u0430\u043A\u0438 \u043E\u0431\u0449\u0438\u0439 \u0443\u0440\u043E\u043D
      , \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 3 \u0441\u0442\u0430\u043A\u0430
      +3 \u0443\u0440\u043E\u043D\u0430, \u0430 \u043D\u0435 +1 \u0443\u0440\u043E\u043D
      3 \u0440\u0430\u0437\u0430) - \u043F\u0440\u0438\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u0435
      +5 \u0435\u0434 - \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430 +10
      \u0435\u0434. "
    _stateInfos: []
    IsOpen: 0
    Description: "\u043C\u043E\u0440\u043E\u0437\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F"
