  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u041F\u0440\u0438 \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438
      \u043D\u0438\u043D\u0434\u0437\u044F \u0432 \u043B\u0435\u0434\u044F\u043D\u043E\u0439
      \u0442\u0435\u043D\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u043D\u0430 1% \u043E\u0442
      \u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430 \u0432
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443. \u041F\u0440\u0438 \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0432
      \u0442\u0435\u043D\u0438 \u0438  \u0432 \u043B\u0443\u0436\u0435 \u043B\u044C\u0434\u0430
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      +3% \u0438\u0442\u043E\u0433\u043E 4%."
    - "\u041F\u0440\u0438 \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438
      \u043D\u0438\u043D\u0434\u0437\u044F \u0432 \u043B\u0443\u0436\u0435 \u043B\u044C\u0434\u0430
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u043D\u0430 1% \u043E\u0442
      \u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430 \u0432
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443."
