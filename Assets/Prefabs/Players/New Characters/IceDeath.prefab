  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2e9cdbbb1287d84da9991b4b1499621, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0410\u0439\u0441 \u0414\u044D\u0437 \u043C\u043E\u0436\u0435\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
      \u0441\u0435\u0440\u0438\u044F\u043C\u0438, \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044F
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0434\u0440\u044F\u0434
      \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u0446\u0435\u043B\u0438 \u0432
      \u043D\u0443\u0436\u043D\u043E\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438,
      \u0441\u043E 2\u0433\u043E \u0443\u0434\u0430\u0440\u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 +30% \u0438 \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C,
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u0442\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      5 \u044D\u043D\u0435\u0440\u0433\u0438\u0438. \u041F\u0440\u0438 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u043C
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0438 \u0441\u0435\u0440\u0438\u0438,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0443\u0434\u0430\u0440
      \u0438\u043C\u0435\u0435\u0442 \u0431\u043E\u043D\u0443\u0441\u043D\u044B\u0439
      \u044D\u0444\u0444\u0435\u043A\u0442. \u0421\u0435\u0440\u0438\u0438: \u0424\u0424\u0424\u0424\u0424\u0424
      - 6 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0434\u0430\u0440\u043E\u0432 
      \u0424\u0424\u0424\u0424\u0424\u041C - 6 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      1 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0434\u0430\u0440"
    _stateInfos: []
    IsOpen: 0
    Description: "\u0421\u0435\u0440\u0438\u0438 \u043D\u0438\u043D\u0434\u0437\u0438"
