  m_EditorClassIdentifier: Assembly-CSharp::FrostTalent_10
  _data:
    _descriptionsForInfoPanel:
    - "\u0413\u0435\u0440\u043E\u0439 \u043A\u0438\u0434\u0430\u0435\u0442 \u043F\u043E
      \u043A\u0430\u0440\u0442\u0435 \u043B\u0435\u0434\u044F\u043D\u0443\u044E \u0441\u0442\u0440\u0435\u043B\u0443,
      \u043F\u043E\u043F\u0430\u0434\u0430\u044F \u0432 \u043F\u0435\u0440\u0432\u0443\u044E
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0443\u044E \u0442\u0435\u043D\u044C
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0443\u0440\u043E\u043D
      \u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0434\u0435\u0431\u0430\u0444
      \xAB\u041E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435\xBB \u0443\u0440\u043E\u043D
      20-25 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 +3 \u0443\u0440\u043E\u043D\u0430
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 5 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
      \u043C\u0430\u043A\u0441 25 \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043A\u0430\u0441\u0442
      2,5 \u0441\u0435\u043A, \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      6 \u043A\u043B\u0435\u0442\u043E\u043A, \u0437\u0430\u0442\u0440\u0430\u0442\u044B
      1 \u0440\u0443\u043D\u0430 \u043B\u044C\u0434\u0430"
