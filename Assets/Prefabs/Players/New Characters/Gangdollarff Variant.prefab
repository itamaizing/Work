  _data:
    _descriptionsForInfoPanel:
    - "\u0417\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0446\u0435\u043B\u044C
      \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u043F\u0430\u043B\u043E
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435,\_\_ \u043D\u0430
      \xAB\u0413\u0430\u043D\u0433\u0434\u043E\u043B\u043B\u0430\u0440\u0444\u0444\u0430\xBB
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F\_
      \xAB\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0430\u0437\u0430\u0440\u0442\xBB,
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435,\_
