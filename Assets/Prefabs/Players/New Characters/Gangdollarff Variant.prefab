  m_Script: {fileID: 11500000, guid: 83d5c0b1c759e02418cd990896fbefd8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AbsorptionBallTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u0421\u043E \u0441\u0432\u0435\u0440\u0445 \u0432\u044B\u0441\u043E\u043A\u043E\u0447\u0430\u0441\u0442\u043D\u044B\u043C\_\u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u0435\u043C
      \_\u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0435\u0431\u044F \_\u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0441\u0432\u0435\u0442\u0430 \u0432
      \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u0443\u043F\u043E\u043B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442
      \u0432\u0435\u0441\u044C \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439
      \u0443\u0440\u043E\u043D \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      2 \u0441\u0435\u043A\u0443\u043D\u0434"
    _stateInfos: []
    Description: "\u0428\u0430\u0440 \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u044F"
