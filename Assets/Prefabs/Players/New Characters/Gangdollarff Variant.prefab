--- !u!114 &2890180143030239208
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8070340911147190486}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1124c827e86f2a54dbe6563ee41521d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ElementalsShieldTalent
  _data:
    _descriptionsForInfoPanel:
    - "\"\u041E\u043A\u0430\u043C\u0435\u043D\u0435\u043D\u0438\u0435\" - \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0446\u0435\u043B\u044C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \"\u041E\u043A\u0430\u043C\u0435\u043D\u0435\u043D\u0438\u0435\"
      \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044E\u0449\u0435\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439
      \u0443\u0440\u043E\u043D \u043D\u0430 80% \u0446\u0435\u043B\u044C \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C 4
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
    - "\"\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0449\u0438\u0442\" -
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0435\u0442 \u043D\u0430
      \u0446\u0435\u043B\u044C \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
      9 \u0441\u0435\u043A\u0443\u043D\u0434 \"\u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
      \u0449\u0438\u0442\" (\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0431\u0430\u0444 \u0448\u043A\u043E\u043B\u0430 \u043E\u0433\u043D\u044F)
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D 1 \u0435\u0434\u0438\u043D\u0438\u0446\u0443
      \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0448\u043A\u043E\u043B\u043E\u0439
      \u043E\u0433\u043D\u044F \u0440\u0430\u0434\u043E\u043C \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u043C\u0441\u044F
      \u043D\u0430 1 \u043A\u043B\u0435\u0442\u043A\u0443 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435,
      \u0446\u0435\u043B\u0438 \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u0435
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438 \u0431\u043B\u0438\u0436\u043D\u0438\u043C
      \u0431\u043E\u0435\u043C \u043F\u043E \u0449\u0438\u0442\u0443 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      \u0434\u0435\u0431\u0430\u0444\u0444 \u0433\u043E\u0440\u0435\u043D\u0438\u0435"
    - "\"\u0429\u0438\u0442 \u0445\u043E\u043B\u043E\u0434\u0430\" - \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0449\u0438\u0442 \u043D\u0430 \u0441\u043E\u044E\u0437\u043D\u0443\u044E
      \u0446\u0435\u043B\u044C \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443
      +10% \u0438 \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u0435 \u0431\u043B\u0438\u0436\u043D\u0435\u043C
      \u0431\u043E\u0435\u043C \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0441\u0442\u0430\u043A
      \"\u041E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F\" "
    _stateInfos: []
    Description: "\u0429\u0438\u0442\u044B \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u0435\u0439"
