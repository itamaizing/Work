  m_Script: {fileID: 11500000, guid: e78075546e19f0e42880af8beb8cae38, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TelekinesisDamageTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u0442\u0435\u043B\u0435\u043A\u0438\u043D\u0435\u0437 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u043C \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      5% \u0443\u0440\u043E\u043D\u0430 \u043E\u0442 \u0438\u043C\u0435\u044E\u0449\u0435\u0433\u043E\u0441\u044F
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F\u0446\u0435\u043B\u0438, \u043F\u0440\u0438
      \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u043C \u044D\u0444\u0444\u0435\u043A\u0442\u0435
      \u043A\u043E\u043D\u0442\u0440\u0441\u043F\u0435\u043B\u043B\u0430, \u0447\u0430\u0440\u043E\u043A\u0440\u0430\u0434\u0435,
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F \u0448\u043A\u043E\u043B,
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F 30% \u0443\u0440\u043E\u043D\u0430
      \u0446\u0435\u043B\u0438 \u043E\u0442 \u0437\u0430\u0442\u0440\u0430\u0447\u0435\u043D\u043E\u0439
      \u043C\u0430\u043D\u043D\u044B \u043D\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u0438\u043B\u0438 \u0441\u043E\u0441\u0442\u043E\u0441\u044F\u043D\u0438\u0435
      \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0431\u044B\u043B\u043E
      \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u043E"
    - "\u043F\u0440\u0438 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u043C \u044D\u0444\u0444\u0435\u043A\u0442\u0435
      \u043A\u043E\u043D\u0442\u0440\u0441\u043F\u0435\u043B\u043B\u0430, \u0447\u0430\u0440\u043E\u043A\u0440\u0430\u0434\u0435,
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F \u0448\u043A\u043E\u043B,
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F 30% \u0443\u0440\u043E\u043D\u0430
      \u0446\u0435\u043B\u0438 \u043E\u0442 \u0437\u0430\u0442\u0440\u0430\u0447\u0435\u043D\u043E\u0439
      \u043C\u0430\u043D\u043D\u044B \u043D\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u0438\u043B\u0438 \u0441\u043E\u0441\u0442\u043E\u0441\u044F\u043D\u0438\u0435
      \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0431\u044B\u043B\u043E
      \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u043E"
