--- !u!114 &386172556007266514
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8070340911147190486}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 73c0e10f99083e947944f6e48a5a3b5f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightingStrikeTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u0431\u044C\u0451\u0442 \u0441 \u043D\u0435\u0431\u0430 \u0432\u0440\u0430\u0433\u0430
      \u043C\u043E\u043B\u043D\u0438\u0435\u0439, \u0438\u043C\u0435\u0435\u0442
      15% \u0448\u0430\u043D\u0441 \u043D\u0430\u043B\u043E\u0436\u0438\u0442\u044C
      \u043D\u0430 \u0446\u0435\u043B\u044C \u0440\u0430\u0437\u0440\u044F\u0436\u0435\u043D\u0438\u0435
      \u043D\u0430 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B. \u0420\u0430\u0437\u0440\u044F\u0436\u0435\u043D\u0438\u0435
      \u2013  \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0441 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E 
      50% \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0439 \u0438\u043B\u0438
      \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441 \u0441\u043E\u044E\u0437\u043D\u043E\u0439 \u0446\u0435\u043B\u0438 
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u044D\u0444\u0444\u0435\u043A\u0442,
      \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0438 
      \u043D\u0430 50%, \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u044D\u0444\u0444\u0435\u043A\u0442, \u0448\u043A\u043E\u043B\u0430 \u0432\u043E\u0437\u0434\u0443\u0445\u0430."
    _stateInfos: []
    Description: "\u0423\u0434\u0430\u0440 \u043C\u043E\u043B\u043D\u0438\u0435\u0439"
