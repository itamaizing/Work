  _data:
    _descriptionsForInfoPanel:
    - "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0437\u0430\u0440\u044F\u0434\u043E\u0432 \u0420\u0430\u0441\u043A\u043E\u043B\u0430
      \u0437\u0435\u043C\u043B\u0438"
    - "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0437\u0430\u0440\u044F\u0434\u043E\u0432 \u0425\u043B\u043E\u043F\u043A\u0430
      \u0432\u043E\u0434\u044B"
    - "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0437\u0430\u0440\u044F\u0434\u043E\u0432 \u0428\u0430\u0440 \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u044F "
