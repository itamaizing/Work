  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ElementalsActiveTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u041C\u043E\u0449\u044C \u0437\u0435\u043C\u043B\u0438 - \u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u044F
      \u0437\u0435\u043C\u043B\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0430\u0443\u0440\u0430 \u0434\u0430\u044E\u0449\u0430\u044F \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C
      20% \u0448\u0430\u043D\u0441 \u0441\u0442\u0430\u043D\u0430 1.5 \u0441\u0435\u043A.
      \u043E\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u043A\u0438\u0445 \u0430\u0442\u0430\u043A,
      \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0441\u0442\u044C 6 \u0441\u0435\u043A\u0443\u043D\u0434,
      \u0434\u0430\u043B\u043D\u043E\u0441\u0442\u044C 6 \u043A\u043B\u0435\u0442\u043E\u043A,
      \u043A\u0434 18 \u0441\u0435\u043A\u0443\u043D\u0434."
    - "\xAB\u0413\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u0437\u0440\u044F\u0436\u0435\u043D\u0438\u044F\xBB
      \u2013 \u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0432\u043E\u0437\u0434\u0443\u0445\u0430
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \xAB\u0440\u0430\u0437\u0440\u044F\u0436\u0435\u043D\u0438\u0435\xBB
      \u043D\u0430 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E \u0446\u0435\u043B\u044C"
    - "\"\u0412\u0437\u0440\u044B\u0432\" - \u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442
      \u043E\u0433\u043D\u044F \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442 \u0446\u0435\u043B\u044C
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \"\u0413\u043E\u0440\u0435\u043D\u0438\u0435\"
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u0430\u043A
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 3 \u0443\u0440\u043E\u043D\u0430.
      \u043A\u0443\u043B\u0434\u0430\u0443\u043D 10 \u0441\u0435\u043A\u0443\u043D\u0434."
    - "\u0417\u0430\u043C\u0435\u0440\u0437\u0430\u043D\u0438\u0435 - \u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442
      \u0432\u043E\u0434\u044B \u0432\u043E\u043A\u0440\u0443\u0433 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u044F
      \u0432\u043E\u0434\u044B \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0435\u043A\u0443\u043D\u0434\u043E\u0439
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434
      \u043D\u0430 1 \u043C\u0435\u0442\u0440 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u043E\u044F\u043D\u0435\u0442\u0441\u044F
      \u0430\u0443\u0440\u0430 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0449\u0430\u044F
      \u043D\u0430 \u0432\u0441\u0435\u0445 \u0432\u0440\u0430\u0436 \u0446\u0435\u043B\u0438
      6 \u0441\u0442\u0430\u043A\u043E\u0432 \u0434\u0435\u0431\u0430\u0444 \"\u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435\""
    _stateInfos: []
    Description: "\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u0435\u0439"
