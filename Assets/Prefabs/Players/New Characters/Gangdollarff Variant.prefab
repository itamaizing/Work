--- !u!114 &1406395723481581508
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8070340911147190486}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c12dc27db3df58047b70423d55020cbb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SchoolSolventTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u043A\u043E\u0433\u0434\u0430 \u0433\u0430\u043D\u0433\u0434\u043E\u043B\u043B\u0430\u0440\u0444
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435
      \u043A\u043E\u043D\u0442\u0440\u0441\u043F\u044D\u043B\u043B\u043E\u043C, \u043E\u043D
      \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442 \u0448\u043A\u043E\u043B\u0443
      \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u0432\u0440\u0438\u0442\u043B\u0435\u044C
      \u0448\u043A\u043E\u043B, \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0448\u043A\u043E\u043B\u044B, \u043A\u0430\u043A\u0438\u0435
      \u0448\u043A\u043E\u043B\u044B \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u044B
      , \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u0440\u0430\u0441\u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C
      \u0448\u043A\u043E\u043B \u043A \u0446\u0435\u043B\u0438 \u0441\u043E\u044E\u0437\u043D\u043E\u0439
      \u0438\u043B\u0438 \u0444\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0439,
      \u0432\u0441\u0435 \u0431\u0430\u0444\u044B \u0438\u043B\u0438 \u0434\u0435\u0431\u0430\u0444\u044B
      \u044D\u0442\u043E\u0439 \u0448\u043A\u043E\u043B\u044B \u0431\u0443\u0434\u0443\u0442
      \u0441\u043D\u044F\u0442\u044B \u0441 \u0446\u0435\u043B\u0438, \u043F\u043E\u0441\u043B\u0435
      \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438,
      \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u0435 \u0448\u043A\u043E\u043B\u044B
      \u0442\u0435\u0440\u044F\u044E\u0442\u0441\u044F."
    _stateInfos: []
    Description: "\u0420\u0430\u0441\u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C
      \u0448\u043A\u043E\u043B "
    ConditionDescription: 
    Icon: {fileID: 21300000, guid: ad21cf949ffd1354c9af7b1196ea1c83, type: 3}
    Group: 0
    Row: 0
    MaxLvl: 0
  OpenCondition:
