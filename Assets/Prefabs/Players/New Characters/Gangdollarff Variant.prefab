  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0413\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u0435\u0442 \u0448\u0430\u0440
      \u0438\u0437 \u0432\u043E\u0434\u044B \u0438 \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442
      \u0435\u0433\u043E, \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D
      \u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044F \u0432\u0440\u0430\u0433\u043E\u0432
      \u043D\u0430 1 \u043C\u0435\u0442\u0440, \u0443\u0440\u043E\u043D \u0438 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043E\u0442\u0431\u0440\u043E\u0441\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u043C \u0446\u0435\u043B\u044F\u043C."
    _stateInfos: []
    IsOpen: 1
    Description: "\u0425\u043B\u043E\u043F\u043E\u043A \u0432\u043E\u0434\u044B"
