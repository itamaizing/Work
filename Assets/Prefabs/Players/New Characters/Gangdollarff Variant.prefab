  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1db6d6dd90d670847a20770795994cdb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HotBloodAuraTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u0430\u0443\u0440\u0430 \"\u0433\u043E\u0440\u044F\u0447\u0430\u044F \u043A\u0440\u043E\u0432\u044C\"
      \u0443\u0432\u0435\u043B\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043A\u0430\u0441\u0442\u043E\u0432, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0430\u043A\u0442\u0430\u043A \u043D\u0430 10%, \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      6 \u043A\u043B\u0435\u0442\u043E\u043A."
    - "\xAB\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0432\u043E\u0434\u0430\xBB
      \u2013 \u0432\u043E\u043A\u0440\u0443\u0433 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u044F
      \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0430\u0443\u0440\u0430
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0430\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043C\u0430\u043D\u043D\u044B \u0441\u043E\u044E\u0437\u043D\u044B\u043C \u0446\u0435\u043B\u044F\u043C
      \u043D\u0430 0,3% \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043E\u0442
      \u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430 "
    - "\xAB\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0437\u0435\u043C\u043B\u0438\xBB
      - \u0430\u0443\u0440\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044E
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u043D\u0430 0,2% \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u043E\u0442 \u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0440\u0430\u0434\u0438\u0443\u0441
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F 6 \u043A\u043B\u0435\u0442\u043E\u043A."
    - "\xAB\u043F\u043E\u0434\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0439
      \u0432\u0435\u0442\u0435\u0440\xBB \u2013 \u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u044F
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0430\u0443\u0440\u0430 \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F,
      \u0434"
    _stateInfos: []
    Description: "\u0410\u0443\u0440\u044B \u043C\u0438\u043D\u044C\u043E\u043D\u043E\u0432"
