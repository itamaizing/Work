  _data:
    _descriptionsForInfoPanel:
    - "\u041F\u0440\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430
      \u0438\u043C\u0435\u0435\u0442 20% \u0448\u0430\u043D\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \"\u0432\u043E\u0437\u043C\u0435\u0437\u0434\u0438\u0435\" \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439
      \u0443\u0440\u043E\u043D \u043C\u0430\u0433\u0438\u0435\u0439 \u0441\u0432\u0435\u0442\u0430
      \u043D\u0430 15% \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0434\u043E 3\u0451\u0445 \u0440\u0430\u0437 \u043D\u0430 6 \u0441\u0435\u043A.,
      \u0441\u043F\u0430\u0434\u0430\u0435\u0442 \u043F\u0440\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
      \u043A\u0430\u0441\u0442\u0443\u044E\u0449\u0438\u0445\u0441\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u043D\u0435 \u0441\u043F\u0430\u0434\u0430\u0435\u0442 \u043F\u0440\u0438
      \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439."
