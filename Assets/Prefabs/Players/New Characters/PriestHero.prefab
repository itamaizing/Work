  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DarkFormTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u0446\u0430 \u0432\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0442\u0451\u043C\u043D\u0443\u044E \u0444\u043E\u0440\u043C\u0443
      \u0441\u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      +15%, \u0432 \u0422\u0424 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \xAB\u0442\u0435\u043D\u044C\xBB,
      \u0432\u0441\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E
      \u043A\u0430\u043A \u0432 \u0442\u0451\u043C\u043D\u043E\u0439 \u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438,
      , \u043F\u0440\u0438\u043C\u0435\u043D\u044F \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E
      \u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043E\u0441\u0442\u044C
      \u043A\u0430\u043A \u0432 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438."
