  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DarkTalent_7
  _data:
    _descriptionsForInfoPanel:
    - "\"\u0418\u0441\u043A\u0440\u0430 \u0442\u044C\u043C\u044B\" \u0438 \"\u041F\u043E\u0442\u043E\u043A
      \u0442\u044C\u043C\u044B\" \u043F\u0440\u0438 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0438
      \u0443\u0440\u043E\u043D\u0430 \u0438\u043C\u0435\u044E\u0442 20% \u0448\u0430\u043D\u0441
      \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u043A \u0446\u0435\u043B\u0438
      \"\u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0435\". \u0415\u0441\u043B\u0438
      \u0443\u0436\u0435 \u0435\u0441\u0442\u044C \"\u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0435\":
      \u043F\u0440\u0438 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0438 \u0443\u0440\u043E\u043D\u0430
      \u043E\u043D\u043E \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B. \u0412 \u0441\u0432\u0435\u0442\u043B\u043E\u0439
      \u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438: \"\u0418\u0441\u043A\u0440\u0430
      \u0441\u0432\u0435\u0442\u0430\" \u0438 \"\u041F\u043E\u0442\u043E\u043A \u0441\u0432\u0435\u0442\u0430\"
      \u043F\u0440\u0438 \u043B\u0435\u0447\u0435\u043D\u0438\u0438 \u0438\u043C\u0435\u044E\u0442
      20% \u0448\u0430\u043D\u0441 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C
      \u043A \u0446\u0435\u043B\u0438 \"\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435\"."
