  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u0418\u0441\u043A\u0440\u0430 \u0441\u0432\u0435\u0442\u0430 \u0438 \u041F\u043E\u0442\u043E\u043A
      \u0441\u0432\u0435\u0442\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0446\u0435\u043B\u044C \u0431\u0430\u0444\u0444 \"\u041E\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0435
      \u0434\u0443\u0448\u0438\". \u0421\u0432\u044F\u0449\u0435\u043D\u0438\u0446\u0430
      \u0438\u043B\u0438 \u0441\u043E\u044E\u0437\u043D\u0438\u043A \u0441 \u0431\u0430\u0444\u0444\u043E\u043C
      \u201C\u041E\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0435 \u0434\u0443\u0448\u0438\u201D 
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043C\u0430\u043D\u0443 \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435
      5% \u043E\u0442 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0441\u0442\u0430\u043A.  \u0418\u0441\u043A\u0440\u0430 \u0442\u044C\u043C\u044B
      \u0438 \u041F\u043E\u0442\u043E\u043A \u0442\u044C\u043C\u044B \u043A\u0430\u0436\u0434\u0443\u044E
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0446\u0435\u043B\u044C \u0434\u0435\u0431\u0430\u0444\u0444
      \"\u041F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435 \u0434\u0443\u0448\u0438\"
      \u043D\u0430 18 \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u0443\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      3 \u0440\u0430\u0437\u0430.  \u0421\u0432\u044F\u0449\u0435\u043D\u0438\u0446\u0430
      \u0438\u043B\u0438 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0438 \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u0435
      \u0446\u0435\u043B\u044C \u0441 \u201C\u041F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435\u043C
      \u0434\u0443\u0448\u0438\u201D \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
      5% \u043C\u0430\u043D\u043D\u044B \u043E\u0442 \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0441\u0442\u0430\u043A"
    _stateInfos: []
    Description: "\u0412\u0437\u0430\u0438\u0432\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0441 \u0434\u0443\u0448\u043E\u0439"
