  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DisciplineHpAuraTalent
  _data:
    _descriptionsForInfoPanel:
    - " \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043A\u0430\u043A
      \u0432\u044B \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0438\u0437 \u0432\u0435\u0442\u043A\u0438 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D
      \u0443 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u0446\u044B \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0430\u0443\u0440\u0430 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
      \u0440\u0430\u0434\u0438\u0443\u0441 10 \u043C\u0435\u0442\u0440\u043E\u0432,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u043E\u0431\u0449\u0438\u0439 \u0437\u0430\u043F\u0430\u0441 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u0446\u0435 \u043D\u0430 10%
      \u0438 \u0441\u043E\u044E\u0437\u043D\u044B\u043C \u0446\u0435\u043B\u044F\u043C
      \u043D\u0430 5% \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u0430\u043A"
