  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MergeDarkTalent
  _data:
    _descriptionsForInfoPanel:
    - "\u0441\u0432\u044F\u0449\u0435\u043D\u0438\u0446\u0430 \u0441\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0442\u044C\u043C\u043E\u0439 \u043D\u0430 4 \u0441\u0435\u043A\u0443\u043D\u0434\u044B,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0448\u0430\u043D\u0441 \u043F\u0440\u043E\u043C\u0430\u0445\u0430 \u043F\u043E
      \u043D\u0435\u0439 \u043D\u0430 +30%, \u0448\u0430\u043D\u0441 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F
      \u043C\u0430\u0433\u0438\u0438 +30%, \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u0432\u0441\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0432 \u0442\u0451\u043C\u043D\u043E\u0439
      \u043F\u043E\u043B\u0440\u044F\u043D\u043E\u0441\u0442\u0438 \u043A\u0430\u043A
      \u0432 \u0442\u0451\u043C\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435,
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u0432\u043E\u0441\u043F\u0440\u0438\u0438\u043C\u0447\u0438\u0432\u0430
      \u043A \u044D\u0444\u0444\u0435\u0442\u043A\u0430\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F"
