--- !u!114 &6520106245208843862
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8908408265001011226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c3eb81b4192e54847b3aa8b302bc381a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _descriptionsForInfoPanel:
    - "\u041F\u043E\u0442\u043E\u043A \u0442\u044C\u043C\u044B - \u0441\u043E\u0437\u0434\u0430\u0451\u0442
      \u043F\u043E\u0442\u043E\u043A \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0430\u044E\u0449\u0438\u0439
      \u0432\u0440\u0430\u0433\u0430 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      3 \u0441\u0435\u043A, \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434
      \u043F\u043E 8 \u0435\u0434\u0438\u043D\u0438\u0446.  \u0412 \u0441\u0432\u0435\u0442\u043B\u043E\u0439
      \u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438: \u041F\u043E\u0442\u043E\u043A
