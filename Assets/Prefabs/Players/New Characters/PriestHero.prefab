  m_Script: {fileID: 11500000, guid: 38086d4bc50904f4584ec7a066dfc07b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RisingShadowTalent
  _data:
    _descriptionsForInfoPanel:
    - " \u0412 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043E\u043A\u043E\u043B\u043E
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u0446\u0435\u043B\u0435\u0439
      \u043F\u043E\u044F\u0432\u044F\u043B\u044F\u044E\u0442\u0441\u044F \u0442\u0435\u043D\u0438
      \u043D\u0430 6 \u0441\u0435\u043A\u0443\u043D\u0434, \u0438\u043C\u044E\u0449\u0438\u0435
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0435\u0436\u0435\u043D\u0438\u044F
      50% \u043E\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0446\u0435\u043B\u0438,
      \u043A\u0430\u0436\u0434\u0430\u044F \u0442\u0435\u043D\u044C \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0438 \u0430\u0442\u0430\u043A\u0443\u0435\u0442 (\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F
      \u0431\u044C\u0442\u0451 \u0440\u0443\u043A\u043E\u0439 1,2 \u0441\u0435\u043A
      \u043F\u0440\u0438\u043C\u0435\u043D) \u0442\u0443 \u0446\u0435\u043B\u044C
      \u0432\u043E\u0437\u043B\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C,
      \u043D\u0430\u043D\u043E\u0441\u044F 2% \u0443\u0440\u043E\u043D\u0430 \u0448\u043A\u043E\u043B\u043E\u0439
      \u0442\u044C\u043C\u044B \u043E\u0442 \u043E\u0431\u0449\u0435\u0433\u043E
      \u0437\u0430\u043F\u0430\u0441\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u0446\u0435\u043B\u0438"
    _stateInfos: []
    Description: "\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u0435 \u0442\u0435\u043D\u0435\u0439"
